---
---

<section id="projects" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Title -->
  <div class="text-center mb-10 sm:mb-12">
    <div class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-violet-500/20 border border-violet-400/40 backdrop-blur-xl shadow-[0_0_25px_rgba(139,92,246,0.35)] mb-4 float-levitate">
      <h2 class="text-xl sm:text-4xl font-black text-white tracking-wider font-mono uppercase">
        HERE IS MY PROJECTS
      </h2>
    </div>
  </div>

  <!-- Search & Filter Bar (Mobile Optimized) -->
  <div class="glass-panel p-4 sm:p-5 rounded-[2rem] border border-white/20 shadow-2xl mb-8 sm:mb-12 flex flex-col md:flex-row items-center justify-between gap-4">
    <!-- Search Input -->
    <div class="w-full md:w-1/2">
      <input 
        type="text" 
        id="project-search-input" 
        placeholder="🔍 Search Peaush's repositories..." 
        class="w-full px-4 sm:px-5 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/40 text-base sm:text-sm focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400 transition-all shadow-inner backdrop-blur-md font-mono"
      />
    </div>

    <!-- Filter Buttons (Smooth Touch Scroll on Mobile) -->
    <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0 scrollbar-none justify-start md:justify-center">
      <button data-lang="all" class="filter-btn shrink-0 active-filter px-4 py-2 rounded-full text-xs font-mono font-bold transition-all duration-300 glass-pill-button bg-violet-500/30 text-violet-200 border-violet-400/50 shadow-[0_0_12px_rgba(139,92,246,0.4)]">
        ALL
      </button>
      <button data-lang="TypeScript" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        TypeScript
      </button>
      <button data-lang="Go" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        Go
      </button>
      <button data-lang="Python" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        Python
      </button>
      <button data-lang="C++" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        C++
      </button>
      <button data-lang="Dart" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        Dart
      </button>
      <button data-lang="JavaScript" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        JavaScript
      </button>
      <button data-lang="HTML" class="filter-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/80 hover:text-white">
        HTML
      </button>
    </div>
  </div>

  <!-- Projects Grid -->
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">

    <!-- Card 1: Nextjs ai analytics dashboard -->
    <div data-lang="TypeScript" data-id="nextjs-ai-analytics" class="project-card glass-panel rounded-[2rem] p-5 sm:p-6 border border-white/20 shadow-2xl relative flex flex-col justify-between group hover:border-violet-400/50 transition-all duration-500 hover:scale-[1.02]">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>

      <div>
        <div class="w-full h-32 sm:h-40 rounded-2xl bg-gradient-to-br from-violet-600/40 via-purple-600/40 to-fuchsia-900/60 border border-violet-400/30 mb-5 sm:mb-6 p-4 relative overflow-hidden flex flex-col items-center justify-center group-hover:scale-[1.02] transition-transform duration-500">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mb-2 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="purple-tech-logo w-8 h-8 sm:w-10 sm:h-10" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
            </svg>
          </div>
          <span class="text-[9px] sm:text-[10px] font-mono font-bold uppercase tracking-wider text-violet-200 bg-violet-950/70 px-3 py-0.5 sm:py-1 rounded-full border border-violet-400/40 shadow-[0_0_12px_rgba(139,92,246,0.4)] backdrop-blur-md">AI DASHBOARD</span>
        </div>

        <h4 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-violet-300 transition-colors">Nextjs ai analytics dashboard</h4>
        <p class="text-xs text-white/70 leading-relaxed mb-6">
          Real-time AI analytics dashboard built with Next.js, React, and Tailwind CSS. Features automated data anomaly detection and live telemetry charting.
        </p>

        <div class="flex flex-wrap gap-2 mb-6">
          <span class="text-[10px] font-mono font-medium text-violet-200 bg-violet-500/20 px-2.5 py-1 rounded-md border border-violet-400/30">TypeScript</span>
          <span class="text-[10px] font-mono font-medium text-violet-200 bg-violet-500/20 px-2.5 py-1 rounded-md border border-violet-400/30">nextjs</span>
          <span class="text-[10px] font-mono font-medium text-violet-200 bg-violet-500/20 px-2.5 py-1 rounded-md border border-violet-400/30">react</span>
        </div>
      </div>

      <!-- Card Action Buttons (CODE + DETAILS) -->
      <div class="pt-4 border-t border-white/10 flex items-center gap-3">
        <button data-modal-trigger="nextjs-ai-analytics" class="open-details-btn flex-1 py-3 rounded-xl bg-purple-600/30 hover:bg-purple-600/50 text-purple-200 font-mono text-xs font-bold border border-purple-400/50 flex items-center justify-center gap-1.5 shadow-[0_0_15px_rgba(168,85,247,0.3)] transition-all">
          <span>📖 DETAILS</span>
        </button>
        <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="flex-1 py-3 rounded-xl bg-violet-500/20 hover:bg-violet-500/30 text-violet-200 font-mono text-xs border border-violet-400/40 flex items-center justify-center gap-1.5 shadow-[0_0_15px_rgba(139,92,246,0.25)] transition-all">
          <svg class="w-4 h-4 text-violet-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>CODE</span>
        </a>
      </div>
    </div>


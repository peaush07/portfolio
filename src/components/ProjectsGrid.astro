  function initAimTrainerCanvas(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    canvas.width = canvas.parentElement?.clientWidth || 400;
    canvas.height = 160;

    let score = 0, clicks = 0;
    let target = { x: canvas.width / 2, y: canvas.height / 2, radius: 22 };

    function spawnTarget() {
      target.x = Math.random() * (canvas.width - 60) + 30;
      target.y = Math.random() * (canvas.height - 60) + 30;
      target.radius = 22;
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      // Target outer aura
      ctx.fillStyle = 'rgba(232, 121, 249, 0.2)';
      ctx.beginPath();
      ctx.arc(target.x, target.y, target.radius + 6, 0, Math.PI * 2);
      ctx.fill();
      // Target center
      ctx.fillStyle = '#C084FC';
      ctx.beginPath();
      ctx.arc(target.x, target.y, target.radius, 0, Math.PI * 2);
      ctx.fill();
      // Bullseye
      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.arc(target.x, target.y, 6, 0, Math.PI * 2);
      ctx.fill();
    }

    const handleAim = (clientX: number, clientY: number) => {
      clicks++;
      const rect = canvas.getBoundingClientRect();
      const clickX = clientX - rect.left;
      const clickY = clientY - rect.top;

      const dist = Math.hypot(clickX - target.x, clickY - target.y);
      if (dist <= target.radius) {
        score++;
        spawnTarget();
      }
      const scoreEl = document.getElementById('aim-score');
      const accEl = document.getElementById('aim-acc');
      if (scoreEl) scoreEl.textContent = score.toString();
      if (accEl) accEl.textContent = `${Math.round((score / clicks) * 100)}%`;
      draw();
    };

    canvas.onclick = (e) => handleAim(e.clientX, e.clientY);
    canvas.ontouchstart = (e) => {
      if (e.touches.length > 0) {
        e.preventDefault();
        handleAim(e.touches[0].clientX, e.touches[0].clientY);
      }
    };

    draw();
  }

  function initRunnerCanvas(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    canvas.width = canvas.parentElement?.clientWidth || 400;
    canvas.height = 160;

    let playerY = 110, vy = 0, isJumping = false, score = 0;
    let obstacleX = canvas.width + 50;

    function loop() {
      if (canvas.classList.contains('hidden')) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Floor line
      ctx.strokeStyle = '#8B5CF6';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, 135);
      ctx.lineTo(canvas.width, 135);
      ctx.stroke();

      // Jump Physics
      vy += 0.8;
      playerY += vy;
      if (playerY >= 110) {
        playerY = 110;
        vy = 0;
        isJumping = false;
      }

      // Player Box
      ctx.fillStyle = '#C084FC';
      ctx.fillRect(40, playerY, 20, 25);

      // Obstacle
      obstacleX -= 4;
      if (obstacleX < -20) {
        obstacleX = canvas.width + Math.random() * 100;
        score += 10;
        const scoreEl = document.getElementById('runner-score');
        if (scoreEl) scoreEl.textContent = `${score}m`;
      }

      ctx.fillStyle = '#F43F5E';
      ctx.fillRect(obstacleX, 115, 15, 20);

      requestAnimationFrame(loop);
    }

    const jump = () => {
      if (!isJumping) {
        vy = -12;
        isJumping = true;
      }
    };

    canvas.addEventListener('click', jump, { passive: true });
    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      jump();
    }, { passive: false });

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && canvas && !canvas.classList.contains('hidden')) {
        e.preventDefault();
        jump();
      }
    });

    loop();
  }


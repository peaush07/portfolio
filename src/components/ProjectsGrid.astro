---
---

<section id="projects" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Title -->
  <div class="text-center mb-12">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">03 // OPEN SOURCE SHOWCASE</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      HERE IS MY <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">PROJECTS</span>
    </h3>
  </div>

  <!-- Search & Filter Controls -->
  <div class="glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl mb-12 flex flex-col md:flex-row items-center justify-between gap-4">
    <!-- Search Input -->
    <div class="w-full md:w-1/2">
      <input 
        type="text" 
        id="project-search-input" 
        placeholder="🔍 Search Peaush's repositories..." 
        class="w-full px-5 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
      />
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-center">
      <button data-lang="all" class="filter-btn active-filter px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button bg-white/20 text-white border-white/40">
        ALL
      </button>
      <button data-lang="TypeScript" class="filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/70 hover:text-white">
        TypeScript
      </button>
      <button data-lang="Go" class="filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/70 hover:text-white">
        Go
      </button>
      <button data-lang="Python" class="filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/70 hover:text-white">
        Python
      </button>
      <button data-lang="C++" class="filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/70 hover:text-white">
        C++
      </button>
      <button data-lang="Dart" class="filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 glass-pill-button text-white/70 hover:text-white">
        Dart
      </button>
    </div>
  </div>

  <!-- Projects Grid Container -->
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <!-- Static Featured Project Cards -->

    <!-- Card 1 -->
    <div data-lang="Astro" class="project-card glass-panel rounded-[2rem] p-6 border border-white/20 shadow-2xl relative flex flex-col justify-between group hover:border-white/40 transition-all duration-500 hover:scale-[1.02]">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-cyan-400/70 to-transparent"></div>

      <div>
        <div class="w-full h-44 rounded-2xl bg-gradient-to-br from-indigo-900/40 via-cyan-900/30 to-black/60 border border-white/10 mb-6 p-4 relative overflow-hidden flex items-center justify-center group-hover:scale-[1.02] transition-transform duration-500">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(34,211,238,0.2),transparent_70%)]"></div>
          <span class="text-4xl group-hover:scale-125 transition-transform duration-500">💎</span>
        </div>

        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-mono text-cyan-300 bg-cyan-500/20 px-3 py-1 rounded-full border border-cyan-400/30">Astro / Glass</span>
          <span class="text-xs font-mono text-white/50">★ 12</span>
        </div>

        <h4 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">PORTFOLIO-2.0</h4>
        <p class="text-xs text-white/70 leading-relaxed mb-6">
          VisionOS & iOS 27 inspired Liquid Glassmorphism Portfolio built with Astro v7, Tailwind CSS, and Lenis 120Hz smooth scroll engine.
        </p>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-white/10">
        <a href="https://github.com/peaush07/PORTFOLIO-2.0" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-white/80 hover:text-white flex items-center gap-1">
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <button type="button" class="preview-btn text-xs font-mono text-cyan-300 hover:text-cyan-200">
          Quick View →
        </button>
      </div>
    </div>

    <!-- Card 2 -->
    <div data-lang="Go" class="project-card glass-panel rounded-[2rem] p-6 border border-white/20 shadow-2xl relative flex flex-col justify-between group hover:border-white/40 transition-all duration-500 hover:scale-[1.02]">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-fuchsia-400/70 to-transparent"></div>

      <div>
        <div class="w-full h-44 rounded-2xl bg-gradient-to-br from-fuchsia-900/40 via-purple-900/30 to-black/60 border border-white/10 mb-6 p-4 relative overflow-hidden flex items-center justify-center group-hover:scale-[1.02] transition-transform duration-500">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(217,70,239,0.2),transparent_70%)]"></div>
          <span class="text-4xl group-hover:scale-125 transition-transform duration-500">⚡</span>
        </div>

        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-mono text-fuchsia-300 bg-fuchsia-500/20 px-3 py-1 rounded-full border border-fuchsia-400/30">Go / Distributed</span>
          <span class="text-xs font-mono text-white/50">★ 48</span>
        </div>

        <h4 class="text-xl font-bold text-white mb-2 group-hover:text-fuchsia-300 transition-colors">raft-consensus-engine</h4>
        <p class="text-xs text-white/70 leading-relaxed mb-6">
          High-performance distributed Raft consensus node and key-value storage engine engineered in C++ & Go.
        </p>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-white/10">
        <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-white/80 hover:text-white flex items-center gap-1">
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <button type="button" class="preview-btn text-xs font-mono text-fuchsia-300 hover:text-fuchsia-200">
          Quick View →
        </button>
      </div>
    </div>

    <!-- Card 3 -->
    <div data-lang="TypeScript" class="project-card glass-panel rounded-[2rem] p-6 border border-white/20 shadow-2xl relative flex flex-col justify-between group hover:border-white/40 transition-all duration-500 hover:scale-[1.02]">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-emerald-400/70 to-transparent"></div>

      <div>
        <div class="w-full h-44 rounded-2xl bg-gradient-to-br from-emerald-900/40 via-teal-900/30 to-black/60 border border-white/10 mb-6 p-4 relative overflow-hidden flex items-center justify-center group-hover:scale-[1.02] transition-transform duration-500">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(52,211,153,0.2),transparent_70%)]"></div>
          <span class="text-4xl group-hover:scale-125 transition-transform duration-500">🤖</span>
        </div>

        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-mono text-emerald-300 bg-emerald-500/20 px-3 py-1 rounded-full border border-emerald-400/30">TypeScript / MCP</span>
          <span class="text-xs font-mono text-white/50">★ 34</span>
        </div>

        <h4 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-300 transition-colors">mcp-server-suite</h4>
        <p class="text-xs text-white/70 leading-relaxed mb-6">
          Model Context Protocol (MCP) server suite providing autonomous workflow execution for AI developer tools.
        </p>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-white/10">
        <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-white/80 hover:text-white flex items-center gap-1">
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <button type="button" class="preview-btn text-xs font-mono text-emerald-300 hover:text-emerald-200">
          Quick View →
        </button>
      </div>
    </div>

  </div>

  <!-- GitHub Stats Banner -->
  <div class="mt-16 glass-panel p-8 rounded-[2.5rem] border border-white/20 shadow-2xl grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    <div>
      <div id="stat-repos-count" class="text-3xl sm:text-4xl font-black text-white font-mono">12+</div>
      <div class="text-xs text-white/60 font-mono mt-1">Public Repositories</div>
    </div>
    <div>
      <div id="stat-stars-count" class="text-3xl sm:text-4xl font-black text-cyan-300 font-mono">100+</div>
      <div class="text-xs text-white/60 font-mono mt-1">Total Stars Earned</div>
    </div>
    <div>
      <div id="stat-followers-count" class="text-3xl sm:text-4xl font-black text-fuchsia-300 font-mono">24</div>
      <div class="text-xs text-white/60 font-mono mt-1">GitHub Followers</div>
    </div>
    <div>
      <div id="stat-top-lang" class="text-3xl sm:text-4xl font-black text-emerald-300 font-mono">Go / TS</div>
      <div class="text-xs text-white/60 font-mono mt-1">Primary Languages</div>
    </div>
  </div>

  <!-- Quick View Modal -->
  <div id="project-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl opacity-0 invisible transition-all duration-300">
    <div class="glass-panel p-8 rounded-[2rem] max-w-lg w-full border border-white/30 shadow-2xl relative translate-y-4 transition-transform duration-300" id="modal-content-box">
      <button id="close-modal-btn" class="absolute top-4 right-4 text-white/60 hover:text-white p-2">
        ✕
      </button>
      <h3 id="modal-title" class="text-2xl font-bold text-white mb-2">Project Title</h3>
      <span id="modal-badge" class="inline-block text-xs font-mono text-cyan-300 bg-cyan-500/20 px-3 py-1 rounded-full border border-cyan-400/30 mb-4">Tech Stack</span>
      <p id="modal-desc" class="text-sm text-white/80 leading-relaxed mb-6">Detailed description goes here...</p>
      <div class="flex justify-end gap-3">
        <a id="modal-gh-link" href="#" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full bg-white/20 text-white text-xs font-mono hover:bg-white/30 border border-white/40">
          Open GitHub Repo
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import { fetchGitHubRepos } from '../scripts/github-api.js';

  const searchInput = document.getElementById('project-search-input');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  // Search Filter
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      cards.forEach(card => {
        const title = card.querySelector('h4')?.textContent.toLowerCase() || '';
        const desc = card.querySelector('p')?.textContent.toLowerCase() || '';
        if (title.includes(term) || desc.includes(term)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }

  // Category/Language Filter
  filterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const lang = target.dataset.lang;

      filterBtns.forEach(b => {
        b.classList.remove('bg-white/20', 'text-white', 'border-white/40', 'active-filter');
        b.classList.add('text-white/70');
      });

      target.classList.add('bg-white/20', 'text-white', 'border-white/40', 'active-filter');
      target.classList.remove('text-white/70');

      cards.forEach(card => {
        if (lang === 'all' || card.dataset.lang === lang) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Modal Script
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const modalTitle = document.getElementById('modal-title');
  const modalBadge = document.getElementById('modal-badge');
  const modalDesc = document.getElementById('modal-desc');
  const modalGh = document.getElementById('modal-gh-link');

  document.querySelectorAll('.preview-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const card = e.currentTarget.closest('.project-card');
      if (!card || !modal) return;

      const title = card.querySelector('h4')?.textContent || 'Project';
      const desc = card.querySelector('p')?.textContent || '';
      const badge = card.querySelector('span')?.textContent || 'Repository';
      const ghLink = card.querySelector('a')?.getAttribute('href') || 'https://github.com/peaush07';

      if (modalTitle) modalTitle.textContent = title;
      if (modalDesc) modalDesc.textContent = desc;
      if (modalBadge) modalBadge.textContent = badge;
      if (modalGh) modalGh.setAttribute('href', ghLink);

      modal.classList.remove('opacity-0', 'invisible');
      modal.classList.add('opacity-100', 'visible');
    });
  });

  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => {
      modal.classList.remove('opacity-100', 'visible');
      modal.classList.add('opacity-0', 'invisible');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('opacity-100', 'visible');
        modal.classList.add('opacity-0', 'invisible');
      }
    });
  }
</script>

  if (closeFooterBtn) closeFooterBtn.addEventListener('click', closeProjectModal);

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeProjectModal();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) {
      closeProjectModal();
    }
  });

  // Copy Terminal Commands Logic
  const copyTerminalBtn = document.getElementById('copy-terminal-btn');
  const copyBtnText = document.getElementById('copy-btn-text');

  if (copyTerminalBtn) {
    copyTerminalBtn.addEventListener('click', async () => {
      const codeText = modalHowToUse?.textContent || '';
      if (!codeText) return;

      try {
        await navigator.clipboard.writeText(codeText);
        
        // Highlight & Success Feedback Animation
        copyTerminalBtn.classList.remove('bg-violet-600/30', 'text-violet-200', 'border-violet-400/60');
        copyTerminalBtn.classList.add('bg-emerald-500/40', 'text-emerald-200', 'border-emerald-400', 'shadow-[0_0_25px_rgba(52,211,153,0.6)]', 'scale-105');
        if (copyBtnText) copyBtnText.textContent = '✓ COPIED TO CLIPBOARD!';

        setTimeout(() => {
          copyTerminalBtn.classList.remove('bg-emerald-500/40', 'text-emerald-200', 'border-emerald-400', 'shadow-[0_0_25px_rgba(52,211,153,0.6)]', 'scale-105');
          copyTerminalBtn.classList.add('bg-violet-600/30', 'text-violet-200', 'border-violet-400/60');
          if (copyBtnText) copyBtnText.textContent = '📋 Copy & Run in Terminal';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy terminal commands: ', err);
      }
    });
  }
</script>

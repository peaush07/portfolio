---
// Pixel Cat Runner Header Widget
---

<div class="header-cat-container relative inline-flex items-center" id="header-cat-widget">
  <button 
    id="cat-runner-btn"
    type="button"
    aria-label="Interactive Cat Companion"
    class="glass-pill-button text-xs py-1 px-3 inline-flex items-center gap-2 group transition-all duration-300 hover:scale-105"
    title="Click to send cat sprinting!"
  >
    <span class="cat-sprite text-base group-hover:rotate-12 transition-transform duration-300">🐱</span>
    <span class="font-mono text-[11px] text-white/80 group-hover:text-white font-medium" id="cat-status-text">Companion</span>
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
  </button>
</div>

<script>
  const catBtn = document.getElementById('cat-runner-btn');
  const catSprite = catBtn?.querySelector('.cat-sprite');
  const catStatus = document.getElementById('cat-status-text');

  const states = ['🐱', '🐈', '😸', '🐾', '⚡'];
  const statusTexts = ['Companion', 'Sprint!', 'Purring', 'Exploring', 'Hyper!'];
  let stateIndex = 0;

  if (catBtn && catSprite && catStatus) {
    catBtn.addEventListener('click', () => {
      stateIndex = (stateIndex + 1) % states.length;
      catSprite.textContent = states[stateIndex];
      catStatus.textContent = statusTexts[stateIndex];

      // Add spin animation
      catSprite.classList.add('scale-125', 'rotate-[360deg]');
      setTimeout(() => {
        catSprite.classList.remove('scale-125', 'rotate-[360deg]');
      }, 500);
    });
  }
</script>

---
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Title -->
  <div class="text-center mb-16">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">04 // Get In Touch</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      Start a <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">Conversation</span>
    </h3>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Contact Info Glass Card (5 Cols) -->
    <div class="lg:col-span-5 glass-panel p-8 sm:p-10 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-cyan-400/80 to-transparent"></div>

      <h4 class="text-2xl font-bold text-white mb-4">Let's build something extraordinary together.</h4>
      <p class="text-sm text-white/70 leading-relaxed mb-8">
        Have a new project idea, a technical inquiry, or want to discuss a full-stack engineering position? Send a message and I'll respond within 24 hours.
      </p>

      <!-- Direct Contact Details -->
      <div class="space-y-4 mb-8">
        <div class="flex items-center gap-3 text-sm text-white/80">
          <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-cyan-300">
            ✉
          </div>
          <div>
            <div class="text-xs text-white/50 font-mono">Email</div>
            <a href="mailto:hello@peaush.dev" class="hover:text-white font-medium">hello@peaush.dev</a>
          </div>
        </div>

        <div class="flex items-center gap-3 text-sm text-white/80">
          <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-fuchsia-300">
            🌐
          </div>
          <div>
            <div class="text-xs text-white/50 font-mono">Location</div>
            <span class="font-medium">Global / Remote Worldwide</span>
          </div>
        </div>
      </div>

      <!-- Social Links -->
      <div class="pt-6 border-t border-white/10">
        <div class="text-xs font-mono text-white/60 uppercase mb-4">Connect Platforms</div>
        <div class="flex items-center gap-3">
          <a href="https://github.com/peaush" target="_blank" rel="noopener noreferrer" class="glass-pill-button p-3 text-white/80 hover:text-white hover:scale-110">
            GitHub
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="glass-pill-button p-3 text-white/80 hover:text-white hover:scale-110">
            LinkedIn
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="glass-pill-button p-3 text-white/80 hover:text-white hover:scale-110">
            X / Twitter
          </a>
        </div>
      </div>
    </div>

    <!-- Contact Form (7 Cols) -->
    <div class="lg:col-span-7 glass-panel p-8 sm:p-10 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-white/50 to-transparent"></div>

      <form id="contact-form" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs font-mono text-white/80 mb-2 uppercase">Your Name</label>
            <input 
              type="text" 
              id="name" 
              required 
              placeholder="Peaush Dev" 
              class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono text-white/80 mb-2 uppercase">Your Email</label>
            <input 
              type="email" 
              id="email" 
              required 
              placeholder="peaush@example.com" 
              class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-xs font-mono text-white/80 mb-2 uppercase">Subject</label>
          <input 
            type="text" 
            id="subject" 
            required 
            placeholder="Project Inquiry / Glass UI Architecture" 
            class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-mono text-white/80 mb-2 uppercase">Message</label>
          <textarea 
            id="message" 
            rows="5" 
            required 
            placeholder="Tell me about your project or vision..." 
            class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-4 rounded-2xl bg-white/20 hover:bg-white/30 text-white font-semibold text-sm border border-white/40 shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_30px_rgba(255,255,255,0.4)] backdrop-blur-md transition-all duration-300 hover:scale-[1.01] active:scale-95 flex items-center justify-center gap-2"
        >
          <span>Send Glass Message</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>

      </form>

      <!-- Toast Alert -->
      <div id="contact-toast" class="hidden mt-4 p-4 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 text-xs font-mono text-center shadow-xl">
        ✓ Message dispatched successfully! I will reply shortly.
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const toast = document.getElementById('contact-toast');

  if (form && toast) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      toast.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        toast.classList.add('hidden');
      }, 5000);
    });
  }
</script>

---
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Title -->
  <div class="text-center mb-16">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">04 // CONNECT WITH ME</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      GET IN TOUCH WITH <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">PEAUSH</span>
    </h3>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Contact Info Glass Card (5 Cols) -->
    <div class="lg:col-span-5 glass-panel p-8 sm:p-10 rounded-[2.5rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-cyan-400/80 to-transparent"></div>

      <h4 class="text-2xl font-bold text-white mb-4">Let's Build Together!</h4>
      <p class="text-sm text-white/70 leading-relaxed mb-8">
        Have an open-source project, systems engineering role, or collaboration idea? Reach out directly!
      </p>

      <!-- Direct Contact Details -->
      <div class="space-y-5 mb-8">
        <div class="flex items-center gap-3 text-sm text-white/80">
          <div class="w-10 h-10 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-cyan-300 text-lg">
            ✉️
          </div>
          <div>
            <div class="text-xs text-white/50 font-mono uppercase">Direct Email</div>
            <a href="mailto:peaushpaul99@gmail.com" class="hover:text-white font-semibold" id="email-address-text">peaushpaul99@gmail.com</a>
          </div>
        </div>

        <div class="flex items-center gap-3 text-sm text-white/80">
          <div class="w-10 h-10 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-fuchsia-300 text-lg">
            📍
          </div>
          <div>
            <div class="text-xs text-white/50 font-mono uppercase">GitHub Profile</div>
            <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="hover:text-white font-semibold">github.com/peaush07</a>
          </div>
        </div>
      </div>

      <!-- Copy Email Button -->
      <button 
        id="copy-email-btn"
        type="button" 
        class="w-full py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-mono text-xs border border-white/20 transition-all flex items-center justify-center gap-2 mb-8"
      >
        <span>📋 COPY EMAIL ADDRESS</span>
      </button>

      <!-- Social Links -->
      <div class="pt-6 border-t border-white/10">
        <div class="text-xs font-mono text-white/60 uppercase mb-4">Social Platforms</div>
        <div class="flex items-center gap-2 flex-wrap">
          <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="glass-pill-button px-3.5 py-2 text-xs font-mono text-white/80 hover:text-white">GitHub</a>
          <a href="https://www.linkedin.com/in/peaush07/" target="_blank" rel="noopener noreferrer" class="glass-pill-button px-3.5 py-2 text-xs font-mono text-white/80 hover:text-white">LinkedIn</a>
          <a href="https://x.com/peaush07" target="_blank" rel="noopener noreferrer" class="glass-pill-button px-3.5 py-2 text-xs font-mono text-white/80 hover:text-white">X / Twitter</a>
          <a href="https://codeforces.com/profile/peaush07" target="_blank" rel="noopener noreferrer" class="glass-pill-button px-3.5 py-2 text-xs font-mono text-white/80 hover:text-white">Codeforces</a>
        </div>
      </div>
    </div>

    <!-- Contact Form (7 Cols) -->
    <div class="lg:col-span-7 glass-panel p-8 sm:p-10 rounded-[2.5rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-white/50 to-transparent"></div>

      <form 
        id="contact-form" 
        name="contact" 
        method="POST" 
        data-netlify="true" 
        netlify-honeypot="bot-field"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="_subject" value="New Portfolio Message for Peaush Paul" />

        <div>
          <label for="contact-name" class="block text-xs font-mono text-white/80 mb-2 uppercase">YOUR NAME</label>
          <input 
            type="text" 
            id="contact-name" 
            name="name" 
            required 
            placeholder="e.g. Alex Johnson" 
            class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-mono text-white/80 mb-2 uppercase">YOUR EMAIL</label>
          <input 
            type="email" 
            id="contact-email" 
            name="email" 
            required 
            placeholder="alex@example.com" 
            class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-mono text-white/80 mb-2 uppercase">YOUR MESSAGE</label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Tell me about your project or opportunity..." 
            class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner backdrop-blur-md resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-4 rounded-2xl bg-white/20 hover:bg-white/30 text-white font-semibold text-sm border border-white/40 shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_30px_rgba(255,255,255,0.4)] backdrop-blur-md transition-all duration-300 hover:scale-[1.01] active:scale-95 flex items-center justify-center gap-2"
        >
          <span>SEND MESSAGE TO PEAUSH 🚀</span>
        </button>

      </form>

      <!-- Toast Alert -->
      <div id="contact-toast" class="hidden mt-4 p-4 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 text-xs font-mono text-center shadow-xl">
        ✓ Message dispatched successfully! Peaush will get back to you soon.
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const toast = document.getElementById('contact-toast');
  const copyBtn = document.getElementById('copy-email-btn');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('peaushpaul99@gmail.com');
      copyBtn.querySelector('span').textContent = '✓ EMAIL COPIED TO CLIPBOARD!';
      setTimeout(() => {
        copyBtn.querySelector('span').textContent = '📋 COPY EMAIL ADDRESS';
      }, 3000);
    });
  }

  if (form && toast) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      toast.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        toast.classList.add('hidden');
      }, 5000);
    });
  }
</script>

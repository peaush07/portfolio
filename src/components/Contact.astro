---
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Header -->
  <div class="text-center mb-16">
    <div class="inline-block px-8 py-3 rounded-full bg-violet-500/20 border border-violet-400/40 backdrop-blur-xl shadow-[0_0_25px_rgba(139,92,246,0.35)] mb-4 float-levitate">
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-wider font-mono uppercase">
        GET IN TOUCH WITH PEAUSH
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Left Box: Contact Info -->
    <div class="lg:col-span-5 glass-panel p-8 sm:p-10 rounded-[2.5rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>

      <h3 class="text-2xl font-bold text-white mb-3">Let's Build Together!</h3>
      <p class="text-sm text-white/70 leading-relaxed mb-8">
        Have an open-source project, systems engineering role, or collaboration idea? Reach out directly!
      </p>

      <!-- Inner Method Box 1: Direct Email -->
      <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner mb-4 flex items-center gap-3.5 group hover:border-violet-400/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-violet-500/20 border border-violet-400/40 flex items-center justify-center text-xl shadow-[0_0_10px_rgba(139,92,246,0.3)]">
          <svg class="tech-logo w-5 h-5 text-violet-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold uppercase text-white/60">DIRECT EMAIL</div>
          <a href="mailto:peaushpaul99@gmail.com" class="text-sm font-bold text-white hover:text-violet-300 font-mono" id="email-address-text">peaushpaul99@gmail.com</a>
        </div>
      </div>

      <!-- Inner Method Box 2: GitHub Profile -->
      <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner mb-6 flex items-center gap-3.5 group hover:border-violet-400/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-violet-500/20 border border-violet-400/40 flex items-center justify-center text-xl shadow-[0_0_10px_rgba(139,92,246,0.3)]">
          <svg class="tech-logo w-5 h-5 text-violet-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold uppercase text-white/60">GITHUB & LOCATION</div>
          <a href="https://github.com/peaush07" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-white hover:text-violet-300 font-mono">Kolkata, India • @peaush07</a>
        </div>
      </div>

      <!-- Copy Email Button -->
      <button 
        id="copy-email-btn"
        type="button" 
        class="w-full py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-mono text-xs font-bold border border-white/20 transition-all flex items-center justify-center gap-2 shadow-lg hover:scale-[1.01]"
      >
        <span>📋 COPY EMAIL ADDRESS</span>
      </button>

    </div>

    <!-- Right Box: Contact Form -->
    <div class="lg:col-span-7 glass-panel p-8 sm:p-10 rounded-[2.5rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-purple-400/80 to-transparent"></div>

      <form 
        id="contact-form" 
        name="contact" 
        method="POST" 
        data-netlify="true" 
        netlify-honeypot="bot-field"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="_subject" value="New Portfolio Message for Peaush Paul" />

        <div>
          <label for="contact-name" class="block text-xs font-mono font-bold text-white/80 mb-2 uppercase">YOUR NAME</label>
          <input 
            type="text" 
            id="contact-name" 
            name="name" 
            required 
            placeholder="e.g. Alex Johnson" 
            class="w-full px-5 py-4 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400 transition-all shadow-inner backdrop-blur-md font-mono"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-mono font-bold text-white/80 mb-2 uppercase">YOUR EMAIL</label>
          <input 
            type="email" 
            id="contact-email" 
            name="email" 
            required 
            placeholder="alex@example.com" 
            class="w-full px-5 py-4 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400 transition-all shadow-inner backdrop-blur-md font-mono"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-mono font-bold text-white/80 mb-2 uppercase">YOUR MESSAGE</label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Tell me about your project or opportunity..." 
            class="w-full px-5 py-4 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-white/30 text-sm focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400 transition-all shadow-inner backdrop-blur-md resize-none font-mono"
          ></textarea>
        </div>

        <!-- Violet Liquid Glass Submit Button -->
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-4 rounded-2xl bg-violet-500/30 hover:bg-violet-500/40 text-violet-200 font-mono font-bold text-sm border border-violet-400/60 shadow-[0_0_20px_rgba(139,92,246,0.35)] hover:shadow-[0_0_30px_rgba(139,92,246,0.55)] backdrop-blur-md transition-all duration-300 hover:scale-[1.01] active:scale-95 flex items-center justify-center gap-2"
        >
          <span>SEND MESSAGE TO ME</span>
        </button>

      </form>

      <!-- Toast Alert -->
      <div id="contact-toast" class="hidden mt-4 p-4 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 text-xs font-mono text-center shadow-xl">
        ✓ Message dispatched successfully! Peaush will get back to you soon.
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const toast = document.getElementById('contact-toast');
  const copyBtn = document.getElementById('copy-email-btn');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('peaushpaul99@gmail.com');
      const span = copyBtn.querySelector('span');
      if (span) {
        span.textContent = '✓ EMAIL COPIED TO CLIPBOARD!';
        setTimeout(() => {
          span.textContent = '📋 COPY EMAIL ADDRESS';
        }, 3000);
      }
    });
  }

  if (form && toast) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      toast.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        toast.classList.add('hidden');
      }, 5000);
    });
  }
</script>

---
---

<div id="cmd-palette-backdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden opacity-0 transition-opacity duration-300 flex items-start justify-center pt-16 sm:pt-24 p-4 overflow-y-auto">
  <div id="cmd-palette-card" class="bg-[#0b0e17] border border-violet-500/40 rounded-[2rem] w-full max-w-2xl overflow-hidden shadow-[0_0_60px_rgba(139,92,246,0.35)] transform scale-95 transition-transform duration-300 relative text-white">
    
    <!-- Search Bar Input -->
    <div class="p-4 sm:p-5 border-b border-white/10 flex items-center gap-3 bg-white/5">
      <span class="text-violet-400 font-mono font-bold text-lg">🔍</span>
      <input 
        type="text" 
        id="cmd-palette-input" 
        placeholder="Type a command or search projects & sections..." 
        class="w-full bg-transparent text-white placeholder-white/40 text-sm sm:text-base font-mono focus:outline-none"
        autocomplete="off"
      />
      <kbd class="hidden sm:inline-block px-2 py-1 rounded bg-white/10 border border-white/20 text-[10px] font-mono text-white/70">ESC</kbd>
    </div>

    <!-- Commands & Navigation List -->
    <div class="p-4 max-h-[60vh] overflow-y-auto space-y-4 text-xs font-mono">
      
      <!-- Group 1: Navigation Jump -->
      <div>
        <div class="text-[10px] font-bold text-violet-400 uppercase tracking-widest px-3 mb-2">SECTIONS & NAVIGATION</div>
        <div class="space-y-1">
          <button data-cmd-type="nav" data-cmd-target="#hero" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-violet-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-violet-500/30">
            <span class="flex items-center gap-2"><span>🏠</span> <span>Home / Hero Section</span></span>
            <span class="text-[10px] text-white/40 group-hover:text-violet-300">#hero</span>
          </button>
          <button data-cmd-type="nav" data-cmd-target="#about" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-violet-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-violet-500/30">
            <span class="flex items-center gap-2"><span>👤</span> <span>About & Experience</span></span>
            <span class="text-[10px] text-white/40 group-hover:text-violet-300">#about</span>
          </button>
          <button data-cmd-type="nav" data-cmd-target="#skills" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-violet-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-violet-500/30">
            <span class="flex items-center gap-2"><span>⚡</span> <span>Skills & Tech Stack</span></span>
            <span class="text-[10px] text-white/40 group-hover:text-violet-300">#skills</span>
          </button>
          <button data-cmd-type="nav" data-cmd-target="#projects" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-violet-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-violet-500/30">
            <span class="flex items-center gap-2"><span>📦</span> <span>Featured Projects</span></span>
            <span class="text-[10px] text-white/40 group-hover:text-violet-300">#projects</span>
          </button>
          <button data-cmd-type="nav" data-cmd-target="#contact" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-violet-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-violet-500/30">
            <span class="flex items-center gap-2"><span>📬</span> <span>Contact & Links</span></span>
            <span class="text-[10px] text-white/40 group-hover:text-violet-300">#contact</span>
          </button>
        </div>
      </div>

      <!-- Group 2: Interactive Developer Actions -->
      <div>
        <div class="text-[10px] font-bold text-purple-400 uppercase tracking-widest px-3 mb-2">DEVELOPER ACTIONS</div>
        <div class="space-y-1">
          <button data-cmd-action="open-cli" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-purple-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-purple-500/30">
            <span class="flex items-center gap-2"><span>💻</span> <span>Launch Fedora CLI Terminal Sandbox</span></span>
            <kbd class="px-2 py-0.5 rounded bg-white/10 text-[10px] text-purple-300">&gt;_ CLI</kbd>
          </button>
          <button data-cmd-action="open-github" class="cmd-item w-full px-3 py-2.5 rounded-xl hover:bg-purple-600/30 text-slate-200 hover:text-white flex items-center justify-between transition-all group border border-transparent hover:border-purple-500/30">
            <span class="flex items-center gap-2"><span>🐙</span> <span>Visit GitHub Profile @peaush07</span></span>
            <span class="text-[10px] text-purple-300">External</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Footer Shortcuts Info -->
    <div class="p-3 sm:p-4 bg-slate-950/80 border-t border-white/10 flex items-center justify-between text-[11px] text-white/50 font-mono">
      <div class="flex items-center gap-3">
        <span><kbd class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 text-white">↑</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 text-white">↓</kbd> to navigate</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 text-white">↵</kbd> to select</span>
      </div>
      <span class="hidden sm:inline">Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 text-white">Cmd + K</kbd> anytime</span>
    </div>

  </div>
</div>

<script>
  const backdrop = document.getElementById('cmd-palette-backdrop');
  const card = document.getElementById('cmd-palette-card');
  const input = document.getElementById('cmd-palette-input');
  const items = document.querySelectorAll('.cmd-item');

  function openCmdPalette() {
    if (!backdrop) return;
    backdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
    });
    input?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeCmdPalette() {
    if (!backdrop) return;
    backdrop.classList.add('opacity-0');
    card?.classList.remove('scale-100');
    card?.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
    }, 300);
  }

  // Global Keyboard Trigger (Cmd+K / Ctrl+K)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (backdrop?.classList.contains('hidden')) {
        openCmdPalette();
      } else {
        closeCmdPalette();
      }
    }
    if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) {
      closeCmdPalette();
    }
  });

  // Filter items on input search
  if (input) {
    input.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase();
      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        if (text.includes(val)) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  // Handle Command Clicks
  items.forEach(item => {
    item.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget as HTMLElement;
      const navTarget = targetBtn.dataset.cmdTarget;
      const action = targetBtn.dataset.cmdAction;

      closeCmdPalette();

      if (navTarget) {
        const sec = document.querySelector(navTarget);
        sec?.scrollIntoView({ behavior: 'smooth' });
      } else if (action === 'open-cli') {
        const cliBtn = document.getElementById('fedora-cli-trigger-btn');
        cliBtn?.click();
      } else if (action === 'open-github') {
        window.open('https://github.com/peaush07', '_blank');
      }
    });
  });

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeCmdPalette();
    });
  }

  // Export helper function to window
  (window as any).openCommandPalette = openCmdPalette;
</script>

---
---

<!-- CLASSY LIQUID GLASS PRELOADER SCREEN WITH WHITE CAT SVG RUNNER -->
<div 
  id="preloader" 
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-[#030712] transition-all duration-700 ease-in-out select-none"
>
  <!-- Background Ambient Fluid Orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-gradient-to-r from-violet-600/20 via-purple-600/20 to-fuchsia-600/20 blur-[120px] animate-pulse"></div>
  </div>

  <!-- Central Liquid Glass Preloader Box -->
  <div 
    id="preloader-box"
    class="glass-panel p-8 sm:p-12 rounded-[2.5rem] max-w-lg w-full border border-white/30 shadow-[0_16px_48px_0_rgba(0,0,0,0.6)] backdrop-blur-3xl relative text-center flex flex-col items-center transition-all duration-700"
  >
    <!-- Specular Rim Light Top Highlight -->
    <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>

    <!-- Top Badge & Live Percentage -->
    <div class="w-full flex items-center justify-between mb-10 pb-4 border-b border-white/10">
      <span class="text-xs font-mono font-bold text-violet-300 bg-violet-500/20 px-3.5 py-1.5 rounded-full border border-violet-400/40 shadow-[0_0_10px_rgba(139,92,246,0.35)]">
        PEAUSH.IS-A.DEV
      </span>
      <span id="preloader-percent" class="text-2xl font-black font-mono text-white bg-gradient-to-r from-violet-300 via-white to-fuchsia-300 bg-clip-text text-transparent">
        0%
      </span>
    </div>

    <!-- Cat Runner Track Wrapper -->
    <div class="w-full relative mb-8 pt-4">
      
      <!-- WHITE CAT SVG RUNNER -->
      <div 
        id="preloader-cat-runner" 
        class="absolute -top-7 left-0 transition-all duration-100 -translate-x-1/2 z-10 pointer-events-none"
      >
        <svg class="cat-svg" viewBox="0 0 64 40" width="52" height="34">
          <!-- White Cat Body -->
          <path class="cat-torso" d="M14 18 C14 12, 38 12, 44 18 C48 22, 44 28, 38 28 C28 28, 18 28, 14 24 Z" fill="#FFFFFF" />
          <!-- White Cat Head -->
          <path class="cat-head" d="M42 14 C42 8, 54 8, 54 14 C54 20, 44 22, 42 14 Z" fill="#FFFFFF" />
          <!-- Gold Ears -->
          <polygon points="44,9 48,2 50,9" fill="#FBBF24" stroke="#FFFFFF" stroke-width="1" />
          <polygon points="50,9 54,3 56,10" fill="#FBBF24" stroke="#FFFFFF" stroke-width="1" />
          <!-- Cat Eye -->
          <circle cx="50" cy="12" r="1.5" fill="#030712" />
          <!-- White Cat Tail -->
          <path class="cat-tail" d="M14 19 C8 17, 6 9, 10 5" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" fill="none" />
          <!-- Running Legs -->
          <line class="cat-leg leg-f1" x1="44" y1="26" x2="48" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-f2" x1="40" y1="26" x2="36" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-b1" x1="22" y1="26" x2="26" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-b2" x1="18" y1="26" x2="14" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>

      <!-- Progress Track Container -->
      <div class="w-full h-3 rounded-full bg-white/10 border border-white/20 p-0.5 overflow-hidden shadow-inner backdrop-blur-md">
        <div 
          id="preloader-fill" 
          class="h-full rounded-full bg-gradient-to-r from-violet-400 via-purple-400 to-fuchsia-400 w-0 transition-all duration-100 shadow-[0_0_15px_rgba(139,92,246,0.8)]"
        ></div>
      </div>
    </div>

    <!-- Dynamic Status Message -->
    <div class="w-full h-8 flex items-center justify-center">
      <p id="preloader-status-text" class="text-xs font-mono text-white/80 tracking-wider">
        [00:01] INITIALIZING LIQUID GLASS GRAPHICS...
      </p>
    </div>

    <!-- Footnote -->
    <div class="mt-6 pt-4 border-t border-white/10 text-[10px] font-mono text-white/40 uppercase tracking-widest">
      PEAUSH PAUL • PORTFOLIO 2.0
    </div>

  </div>
</div>

<style>
  /* White Cat Running Legs Animations */
  @keyframes catLeg1 {
    0%, 100% { transform: rotate(-22deg); transform-origin: top center; }
    50% { transform: rotate(22deg); transform-origin: top center; }
  }
  @keyframes catLeg2 {
    0%, 100% { transform: rotate(22deg); transform-origin: top center; }
    50% { transform: rotate(-22deg); transform-origin: top center; }
  }
  .leg-f1, .leg-b1 { animation: catLeg1 0.22s infinite ease-in-out; }
  .leg-f2, .leg-b2 { animation: catLeg2 0.22s infinite ease-in-out; }
</style>

<script>
  document.body.classList.add('overflow-hidden');

  const preloader = document.getElementById('preloader');
  const preloaderBox = document.getElementById('preloader-box');
  const percentText = document.getElementById('preloader-percent');
  const fillBar = document.getElementById('preloader-fill');
  const catRunner = document.getElementById('preloader-cat-runner');
  const statusText = document.getElementById('preloader-status-text');

  const statusMessages = [
    "[00:01] INITIALIZING LIQUID GLASS GRAPHICS...",
    "[00:02] LOADING PEAUSH PAUL @peaush07 DATA...",
    "[00:03] SYNCING GITHUB REPOSITORIES & METRICS...",
    "[00:04] CALIBRATING 120Hz LENIS SMOOTH SCROLL...",
    "[00:05] GLASS SYSTEM OPERATIONAL • 100%"
  ];

  let progress = 0;
  const interval = setInterval(() => {
    progress += Math.floor(Math.random() * 7) + 3;
    if (progress > 100) progress = 100;

    if (percentText) percentText.textContent = `${progress}%`;
    if (fillBar) fillBar.style.width = `${progress}%`;
    if (catRunner) catRunner.style.left = `${progress}%`;

    const msgIdx = Math.min(Math.floor((progress / 100) * statusMessages.length), statusMessages.length - 1);
    if (statusText) statusText.textContent = statusMessages[msgIdx];

    if (progress === 100) {
      clearInterval(interval);
      
      setTimeout(() => {
        if (preloaderBox) {
          preloaderBox.classList.add('scale-110', 'opacity-0');
        }
        if (preloader) {
          preloader.classList.add('opacity-0', 'pointer-events-none', '-translate-y-8');
          setTimeout(() => {
            preloader.style.display = 'none';
            document.body.classList.remove('overflow-hidden');
          }, 700);
        }
      }, 500);
    }
  }, 60);
</script>

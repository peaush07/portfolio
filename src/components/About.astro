---
---

<section id="about" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <!-- Section Title -->
  <div class="text-center mb-16">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">01 // Engineering Bio</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      About <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">My Practice</span>
    </h3>
  </div>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Bio Card (7 Cols) -->
    <div class="lg:col-span-7 glass-panel p-8 sm:p-10 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-white/50 to-transparent"></div>

      <h4 class="text-xl sm:text-2xl font-bold text-white mb-6 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-cyan-400 shadow-[0_0_10px_rgba(34,211,238,0.8)]"></span>
        Crafting Digital Products with Precision & Passion
      </h4>

      <div class="space-y-4 text-white/80 text-sm sm:text-base leading-relaxed">
        <p>
          I specialize in building ultra-responsive, highly optimized web applications that blur the line 
          between standard web interfaces and native desktop application feel. My philosophy centres around 
          uncompromising aesthetic quality paired with robust, maintainable architecture.
        </p>
        <p>
          Whether designing full-stack web platforms using <span class="text-cyan-300 font-mono font-medium">Astro</span>, <span class="text-cyan-300 font-mono font-medium">React</span>, and <span class="text-cyan-300 font-mono font-medium">Node.js</span>, or engineering custom glassmorphism visual design systems, I ensure every detail is tuned for 120Hz frame rates and cross-browser reliability.
        </p>
      </div>

      <!-- Experience Highlight Badges -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-white/10">
        <div class="glass-pill-button p-4 flex flex-col items-center text-center">
          <span class="text-xs text-cyan-300 font-mono">Architecture</span>
          <span class="text-sm font-semibold text-white mt-1">Modular & Scalable</span>
        </div>
        <div class="glass-pill-button p-4 flex flex-col items-center text-center">
          <span class="text-xs text-fuchsia-300 font-mono">Performance</span>
          <span class="text-sm font-semibold text-white mt-1">100/100 Lighthouse</span>
        </div>
        <div class="glass-pill-button p-4 flex flex-col items-center text-center">
          <span class="text-xs text-emerald-300 font-mono">Security</span>
          <span class="text-sm font-semibold text-white mt-1">Strict & Hardened</span>
        </div>
      </div>
    </div>

    <!-- Tech Stack Interactive Card (5 Cols) -->
    <div class="lg:col-span-5 glass-panel p-8 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-white/50 to-transparent"></div>

      <h4 class="text-xl font-bold text-white mb-6 flex items-center justify-between">
        <span>Core Tech Arsenal</span>
        <span class="text-xs font-mono text-white/50">2026 Ready</span>
      </h4>

      <!-- Tech Pills -->
      <div class="flex flex-wrap gap-2.5">
        <span class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-mono text-white transition-all hover:scale-105">JavaScript (ESNext)</span>
        <span class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-mono text-white transition-all hover:scale-105">TypeScript</span>
        <span class="px-3.5 py-2 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400/40 text-xs font-mono text-cyan-200 transition-all hover:scale-105">Astro v7</span>
        <span class="px-3.5 py-2 rounded-xl bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-400/40 text-xs font-mono text-indigo-200 transition-all hover:scale-105">React 19</span>
        <span class="px-3.5 py-2 rounded-xl bg-fuchsia-500/20 hover:bg-fuchsia-500/30 border border-fuchsia-400/40 text-xs font-mono text-fuchsia-200 transition-all hover:scale-105">Node.js / Express</span>
        <span class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-mono text-white transition-all hover:scale-105">Tailwind CSS</span>
        <span class="px-3.5 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/40 text-xs font-mono text-emerald-200 transition-all hover:scale-105">Git / GitHub Actions</span>
        <span class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-mono text-white transition-all hover:scale-105">REST & GraphQL</span>
        <span class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-mono text-white transition-all hover:scale-105">Vite / Webpack</span>
      </div>

      <!-- Quick Timeline preview -->
      <div class="mt-8 pt-6 border-t border-white/10">
        <h5 class="text-xs font-mono text-white/60 uppercase mb-4">Milestones</h5>
        <div class="space-y-3">
          <div class="flex items-start gap-3 text-xs">
            <span class="font-mono text-cyan-300 font-semibold w-16">2024-Present</span>
            <span class="text-white/80">Senior Full-Stack & Glass UI Architect</span>
          </div>
          <div class="flex items-start gap-3 text-xs">
            <span class="font-mono text-white/50 w-16">2022-2024</span>
            <span class="text-white/70">Lead Frontend Engineer @ Tech Studio</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

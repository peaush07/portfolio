---
---

<section id="github-activity" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <!-- Section Title -->
  <div class="text-center mb-8 sm:mb-10">
    <div class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-violet-500/20 border border-violet-400/40 backdrop-blur-xl shadow-[0_0_25px_rgba(139,92,246,0.35)] mb-4 float-levitate">
      <h2 class="text-xl sm:text-4xl font-black text-white tracking-wider font-mono uppercase flex items-center justify-center gap-3">
        <span>📊 LIVE GITHUB TELEMETRY</span>
      </h2>
    </div>
    <p class="text-xs sm:text-sm text-purple-200/80 font-mono">Real-time stats synced from @peaush07</p>
  </div>

  <!-- 4-Stat Glass Bar -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">

    <!-- Stat: Repos -->
    <div class="glass-panel p-5 sm:p-6 rounded-[1.75rem] border border-white/20 shadow-2xl flex flex-col items-center justify-center gap-2 relative overflow-hidden group hover:border-violet-400/50 transition-all duration-300">
      <div class="absolute top-0 left-4 right-4 h-[1px] bg-gradient-to-r from-transparent via-violet-400/70 to-transparent"></div>
      <div class="text-3xl sm:text-4xl font-black text-white font-mono" id="stat-repos">—</div>
      <div class="text-[10px] sm:text-xs font-mono text-violet-300/80 tracking-widest uppercase">Public Repos</div>
      <div class="absolute inset-0 bg-violet-500/0 group-hover:bg-violet-500/5 transition-all duration-500 rounded-[1.75rem]"></div>
    </div>

    <!-- Stat: Stars -->
    <div class="glass-panel p-5 sm:p-6 rounded-[1.75rem] border border-white/20 shadow-2xl flex flex-col items-center justify-center gap-2 relative overflow-hidden group hover:border-yellow-400/50 transition-all duration-300">
      <div class="absolute top-0 left-4 right-4 h-[1px] bg-gradient-to-r from-transparent via-yellow-400/70 to-transparent"></div>
      <div class="text-3xl sm:text-4xl font-black text-white font-mono" id="stat-stars">—</div>
      <div class="text-[10px] sm:text-xs font-mono text-yellow-300/80 tracking-widest uppercase">Total Stars</div>
      <div class="absolute inset-0 bg-yellow-500/0 group-hover:bg-yellow-500/5 transition-all duration-500 rounded-[1.75rem]"></div>
    </div>

    <!-- Stat: Followers -->
    <div class="glass-panel p-5 sm:p-6 rounded-[1.75rem] border border-white/20 shadow-2xl flex flex-col items-center justify-center gap-2 relative overflow-hidden group hover:border-emerald-400/50 transition-all duration-300">
      <div class="absolute top-0 left-4 right-4 h-[1px] bg-gradient-to-r from-transparent via-emerald-400/70 to-transparent"></div>
      <div class="text-3xl sm:text-4xl font-black text-white font-mono" id="stat-followers">—</div>
      <div class="text-[10px] sm:text-xs font-mono text-emerald-300/80 tracking-widest uppercase">Followers</div>
      <div class="absolute inset-0 bg-emerald-500/0 group-hover:bg-emerald-500/5 transition-all duration-500 rounded-[1.75rem]"></div>
    </div>

    <!-- Stat: Contributions (Static) -->
    <div class="glass-panel p-5 sm:p-6 rounded-[1.75rem] border border-white/20 shadow-2xl flex flex-col items-center justify-center gap-2 relative overflow-hidden group hover:border-fuchsia-400/50 transition-all duration-300">
      <div class="absolute top-0 left-4 right-4 h-[1px] bg-gradient-to-r from-transparent via-fuchsia-400/70 to-transparent"></div>
      <div class="text-3xl sm:text-4xl font-black text-white font-mono" id="stat-commits">—</div>
      <div class="text-[10px] sm:text-xs font-mono text-fuchsia-300/80 tracking-widest uppercase">Commits</div>
      <div class="absolute inset-0 bg-fuchsia-500/0 group-hover:bg-fuchsia-500/5 transition-all duration-500 rounded-[1.75rem]"></div>
    </div>

  </div>

  <!-- GitHub Profile Link -->
  <div class="mt-8 flex justify-center">
    <a
      href="https://github.com/peaush07"
      target="_blank"
      rel="noopener noreferrer"
      class="glass-panel px-8 py-3 rounded-full border border-violet-400/40 text-violet-200 font-mono text-sm tracking-wider hover:border-violet-400/80 hover:bg-violet-500/10 transition-all duration-300 flex items-center gap-2.5 shadow-[0_0_20px_rgba(139,92,246,0.2)] hover:shadow-[0_0_30px_rgba(139,92,246,0.4)]"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      VIEW FULL GITHUB PROFILE ➔
    </a>
  </div>

</section>

<script>
  import { fetchGithubProfileStats } from '../scripts/github-api.js';

  async function syncStats() {
    try {
      const data = await fetchGithubProfileStats();
      if (data) {
        const rEl = document.getElementById('stat-repos');
        const fEl = document.getElementById('stat-followers');
        const sEl = document.getElementById('stat-stars');
        const cEl = document.getElementById('stat-commits');
        if (rEl && data.public_repos !== undefined) rEl.textContent = String(data.public_repos);
        if (fEl && data.followers !== undefined) fEl.textContent = String(data.followers);
        if (sEl) sEl.textContent = data.total_stars !== undefined ? String(data.total_stars) : '120+';
        if (cEl) cEl.textContent = data.total_commits !== undefined ? String(data.total_commits) : '500+';
      }
    } catch(e) {
      // fallback values
      const fallbacks: Record<string, string> = {
        'stat-repos': '15+',
        'stat-stars': '120+',
        'stat-followers': '30+',
        'stat-commits': '500+'
      };
      Object.entries(fallbacks).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el && el.textContent === '—') el.textContent = val;
      });
    }
  }

  syncStats();
</script>

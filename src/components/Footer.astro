    </div>

    <!-- Bottom Tagline -->
    <div class="text-center text-xs font-mono text-white/50">
      Designed & Engineered with <span class="text-violet-300 font-semibold">Liquid Glass Aesthetics</span> by <strong class="text-white">Peaush Paul</strong>.
    </div>

  </div>

  <!-- TERMS & CONDITIONS MODAL OVERLAY -->
  <div id="terms-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl opacity-0 invisible transition-all duration-300">
    <div class="glass-panel p-8 rounded-[2rem] max-w-xl w-full border border-white/30 shadow-2xl relative translate-y-4 transition-transform duration-300 max-h-[85vh] overflow-y-auto">
      <button id="close-terms-modal" class="absolute top-4 right-4 text-white/60 hover:text-white p-2 text-lg">✕</button>
      <span class="text-xs font-mono text-violet-300 bg-violet-500/20 px-3 py-1 rounded-full border border-violet-400/30 inline-block mb-3">LEGAL STATEMENT</span>
      <h3 class="text-2xl font-bold text-white mb-4">Terms & Conditions</h3>
      
      <div class="space-y-4 text-xs text-white/80 leading-relaxed font-sans mb-6">
        <p><strong class="text-white">1. Acceptance of Terms:</strong> By accessing and viewing this developer portfolio (peaush.is-a.dev / PORTFOLIO-2.0), you agree to comply with all copyright, open-source license, and usage terms outlined herein.</p>
        <p><strong class="text-white">2. Intellectual Property & Copyright:</strong> All custom code, design layouts, graphics, branding, and written content contained in this website are © 2026 Peaush Paul (@peaush07). Unauthorized duplication or scraping without attribution is prohibited.</p>
        <p><strong class="text-white">3. Open-Source Code & Repositories:</strong> Source code featured in the projects section is licensed under their respective repository licenses (MIT / Apache 2.0 / GPL). You are free to inspect, fork, and contribute to public repositories in accordance with their respective open-source licenses.</p>
        <p><strong class="text-white">4. Disclaimer of Liability:</strong> All projects, demos, and code samples provided on this portfolio are offered for educational and demonstration purposes. No guarantee or warranty is provided for third-party production deployments.</p>
      </div>

      <button id="accept-terms-btn" class="w-full py-3 rounded-2xl bg-violet-500/20 hover:bg-violet-500/30 text-violet-200 font-mono text-xs border border-violet-400/40">
        I UNDERSTAND & AGREE 🚀
      </button>
    </div>
  </div>

  <!-- PRIVACY POLICY MODAL OVERLAY -->
  <div id="privacy-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl opacity-0 invisible transition-all duration-300">
    <div class="glass-panel p-8 rounded-[2rem] max-w-xl w-full border border-white/30 shadow-2xl relative translate-y-4 transition-transform duration-300 max-h-[85vh] overflow-y-auto">
      <button id="close-privacy-modal" class="absolute top-4 right-4 text-white/60 hover:text-white p-2 text-lg">✕</button>
      <span class="text-xs font-mono text-purple-300 bg-purple-500/20 px-3 py-1 rounded-full border border-purple-400/30 inline-block mb-3">PRIVACY STATEMENT</span>
      <h3 class="text-2xl font-bold text-white mb-4">Privacy & Data Disclosure</h3>
      
      <div class="space-y-4 text-xs text-white/80 leading-relaxed font-sans mb-6">
        <p><strong class="text-white">1. Data Collection:</strong> This portfolio does not place tracking cookies, run invasive third-party telemetry, or monetize user browsing data.</p>
        <p><strong class="text-white">2. Contact Form Submissions:</strong> When you send a message through the contact form, your name, email, and message content are securely processed solely for the purpose of communicating with Peaush Paul.</p>
        <p><strong class="text-white">3. Hosting & Infrastructure:</strong> This website is hosted on modern cloud edge infrastructure. Standard web server access logs are processed strictly for security and operational diagnostics.</p>
      </div>

      <button id="accept-privacy-btn" class="w-full py-3 rounded-2xl bg-purple-500/20 hover:bg-purple-500/30 text-purple-200 font-mono text-xs border border-purple-400/40">
        CLOSE PRIVACY NOTICE 🔒
      </button>
    </div>
  </div>

</footer>

<script>
  // Terms & Privacy Modal Logic
  const termsBtn = document.getElementById('open-terms-btn');
  const termsModal = document.getElementById('terms-modal');
  const closeTerms = document.getElementById('close-terms-modal');
  const acceptTerms = document.getElementById('accept-terms-btn');

  const privacyBtn = document.getElementById('open-privacy-btn');
  const privacyModal = document.getElementById('privacy-modal');
  const closePrivacy = document.getElementById('close-privacy-modal');
  const acceptPrivacy = document.getElementById('accept-privacy-btn');

  function openM(m) {
    if (!m) return;
    m.classList.remove('opacity-0', 'invisible');
    m.classList.add('opacity-100', 'visible');
  }

  function closeM(m) {
    if (!m) return;
    m.classList.remove('opacity-100', 'visible');
    m.classList.add('opacity-0', 'invisible');
  }

  if (termsBtn && termsModal) termsBtn.addEventListener('click', () => openM(termsModal));
  if (closeTerms && termsModal) closeTerms.addEventListener('click', () => closeM(termsModal));
  if (acceptTerms && termsModal) acceptTerms.addEventListener('click', () => closeM(termsModal));

  if (privacyBtn && privacyModal) privacyBtn.addEventListener('click', () => openM(privacyModal));
  if (closePrivacy && privacyModal) closePrivacy.addEventListener('click', () => closeM(privacyModal));
  if (acceptPrivacy && privacyModal) acceptPrivacy.addEventListener('click', () => closeM(privacyModal));
</script>

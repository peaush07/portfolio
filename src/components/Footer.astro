        </p>
        <div class="flex flex-wrap gap-2">
          <button id="open-terms-btn" type="button" class="glass-pill-button px-3.5 py-1.5 text-xs font-mono text-violet-300 hover:text-white">
            📜 TERMS & CONDITIONS
          </button>
          <button id="open-privacy-btn" type="button" class="glass-pill-button px-3.5 py-1.5 text-xs font-mono text-purple-300 hover:text-white">
            🔒 PRIVACY POLICY
          </button>
        </div>
      </div>

      <!-- Column 3: Location & Back to top -->
      <div class="flex flex-col justify-between items-start">
        <div>
          <h4 class="text-sm font-bold text-white uppercase mb-3 font-mono tracking-wider">LOCATION & AVAILABILITY</h4>
          <p class="leading-relaxed text-white/80 font-medium mb-2">
            📍 Kolkata, West Bengal, India 🇮🇳<br/>
            💼 Open for Internship & Engineering Opportunities
          </p>
        </div>

        <a 
          href="#hero" 
          class="mt-4 glass-pill-button py-2 px-4 text-xs font-mono text-violet-300 hover:text-white inline-flex items-center gap-1.5 border border-violet-400/30"

<footer id="footer" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  <div class="glass-panel p-8 sm:p-12 rounded-[2.5rem] border border-white/20 shadow-2xl space-y-8">
    
    <!-- Top 3 Columns Grid -->

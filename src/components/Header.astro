---
import HeaderCatRunner from './HeaderCatRunner.astro';
---

<header class="fixed top-4 left-0 right-0 z-50 px-4 md:px-8 max-w-7xl mx-auto transition-all duration-300 pointer-events-none">
  <nav 
    class="glass-panel pointer-events-auto rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] border border-white/20 backdrop-blur-2xl transition-all duration-300"
    aria-label="Main Navigation"
  >
    <!-- Brand Logo -->
    <a 
      href="#hero" 
      class="flex items-center gap-2 group text-white font-black text-lg sm:text-xl tracking-tight"
    >
      <div class="w-8 h-8 rounded-full bg-white/10 border border-white/30 flex items-center justify-center group-hover:scale-110 group-hover:bg-white/20 group-hover:border-white/50 transition-all duration-300 shadow-[0_0_12px_rgba(255,255,255,0.2)]">
        <span class="bg-gradient-to-r from-cyan-400 via-indigo-300 to-fuchsia-400 bg-clip-text text-transparent">P</span>
      </div>
      <span class="hidden sm:inline-block bg-gradient-to-r from-white via-white/90 to-white/70 bg-clip-text text-transparent font-medium">
        Peaush<span class="text-cyan-400 font-bold">.</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-full border border-white/10">
      <a href="#about" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">About</a>
      <a href="#skills" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Skills</a>
      <a href="#projects" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Projects</a>
      <a href="#contact" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Contact</a>
    </div>

    <!-- Actions & Widgets -->
    <div class="flex items-center gap-2.5">
      <!-- Cat Runner -->
      <HeaderCatRunner />

      <!-- Theme Selector Dropdown -->
      <div class="relative group">
        <button 
          id="theme-toggle-btn"
          type="button" 
          aria-label="Switch Theme" 
          class="glass-pill-button py-1 px-2.5 text-xs inline-flex items-center gap-1.5 text-white/90 hover:text-white"
        >
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-23"></path>
          </svg>
          <span id="theme-label" class="hidden lg:inline text-[11px] uppercase tracking-wider font-mono">Nebula</span>
          <svg class="w-3 h-3 text-white/60 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute right-0 top-full mt-2 w-36 rounded-2xl glass-panel p-2 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-white/20 z-50">
          <button data-theme-set="nebula" class="theme-opt-btn w-full text-left px-3 py-1.5 text-xs text-white/80 hover:text-white rounded-xl hover:bg-white/15 flex items-center gap-2 transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shadow-[0_0_6px_rgba(99,102,241,0.8)]"></span> Nebula
          </button>
          <button data-theme-set="emerald" class="theme-opt-btn w-full text-left px-3 py-1.5 text-xs text-white/80 hover:text-white rounded-xl hover:bg-white/15 flex items-center gap-2 transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]"></span> Emerald
          </button>
          <button data-theme-set="solar" class="theme-opt-btn w-full text-left px-3 py-1.5 text-xs text-white/80 hover:text-white rounded-xl hover:bg-white/15 flex items-center gap-2 transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.8)]"></span> Solar
          </button>
          <button data-theme-set="velvet" class="theme-opt-btn w-full text-left px-3 py-1.5 text-xs text-white/80 hover:text-white rounded-xl hover:bg-white/15 flex items-center gap-2 transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-fuchsia-500 shadow-[0_0_6px_rgba(217,70,239,0.8)]"></span> Velvet
          </button>
        </div>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        aria-label="Toggle Mobile Menu" 
        class="md:hidden glass-pill-button p-2 text-white/80 hover:text-white"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-drawer" 
    class="md:hidden fixed top-20 left-4 right-4 z-40 rounded-3xl glass-panel p-6 border border-white/20 shadow-2xl transition-all duration-300 opacity-0 invisible translate-y-[-10px] pointer-events-auto"
  >
    <div class="flex flex-col gap-3">
      <a href="#about" class="mobile-link px-4 py-2.5 text-sm font-medium text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors">About</a>
      <a href="#skills" class="mobile-link px-4 py-2.5 text-sm font-medium text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors">Skills</a>
      <a href="#projects" class="mobile-link px-4 py-2.5 text-sm font-medium text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors">Projects</a>
      <a href="#contact" class="mobile-link px-4 py-2.5 text-sm font-medium text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors">Contact</a>
    </div>
  </div>
</header>

<script>
  // Theme Switching Script
  const themeButtons = document.querySelectorAll('.theme-opt-btn');
  const themeLabel = document.getElementById('theme-label');

  function applyTheme(themeName) {
    document.documentElement.dataset.theme = themeName;
    localStorage.setItem('portfolio-theme', themeName);
    if (themeLabel) {
      themeLabel.textContent = themeName;
    }
  }

  // Load saved theme
  const savedTheme = localStorage.getItem('portfolio-theme') || 'nebula';
  applyTheme(savedTheme);

  themeButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const theme = target.dataset.themeSet;
      if (theme) {
        applyTheme(theme);
      }
    });
  });

  // Mobile Menu Script
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      const isVisible = mobileDrawer.classList.contains('opacity-100');
      if (isVisible) {
        mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
      } else {
        mobileDrawer.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileDrawer.classList.add('opacity-100', 'visible', 'translate-y-0');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
      });
    });
  }
</script>

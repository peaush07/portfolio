---
---

<header class="fixed top-4 left-0 right-0 z-50 px-4 md:px-8 max-w-7xl mx-auto transition-all duration-300 pointer-events-none">
  <nav 
    class="glass-panel pointer-events-auto rounded-[2rem] px-4 sm:px-6 py-3 relative shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] border border-white/20 backdrop-blur-2xl transition-all duration-300 overflow-hidden"
    aria-label="Main Navigation"
  >
    <div class="flex items-center justify-between relative z-10">
      <!-- Brand Logo -->
      <a 
        href="#hero" 
        class="flex items-center gap-2 group text-white font-black text-base sm:text-lg tracking-tight"
      >
        <div class="w-8 h-8 rounded-full bg-white/10 border border-white/30 flex items-center justify-center group-hover:scale-110 group-hover:bg-white/20 group-hover:border-white/50 transition-all duration-300 shadow-[0_0_12px_rgba(139,92,246,0.4)]">
          <span class="bg-gradient-to-r from-violet-400 via-purple-300 to-fuchsia-400 bg-clip-text text-transparent">P</span>
        </div>
        <span class="bg-gradient-to-r from-white via-white/90 to-white/70 bg-clip-text text-transparent font-bold">
          PEAUSH PAUL<span class="text-violet-400 font-bold">.</span>
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-full border border-white/10">
        <a href="#hero" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Home</a>
        <a href="#about" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">About</a>
        <a href="#skills" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Skills</a>
        <a href="#projects" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Projects</a>
        <a href="#contact" class="px-4 py-1.5 text-xs font-medium text-white/80 hover:text-white rounded-full hover:bg-white/10 transition-all duration-200">Contact</a>
      </div>

      <!-- Actions & Widgets -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Cmd+K Spotlight Search Button (Visible on sm+) -->
        <button 
          id="cmd-palette-trigger-btn"
          type="button" 
          class="hidden sm:flex glass-pill-button py-1 px-3 text-xs font-mono text-violet-300 hover:text-white border-violet-500/40 bg-violet-500/10 items-center gap-1.5 shadow-[0_0_12px_rgba(139,92,246,0.3)] hover:scale-105 transition-all"
          title="Open Command Palette (Cmd + K)"
        >
          <span class="text-violet-400 font-bold">🔍</span>
          <span class="font-bold text-[11px]">⌘K</span>
        </button>

        <!-- Web Audio Sound FX Toggle -->
        <button 
          id="header-sound-btn"
          type="button" 
          class="glass-pill-button py-1 px-2.5 sm:px-3 text-xs font-mono text-emerald-300 hover:text-white border-emerald-500/40 bg-emerald-500/10 flex items-center gap-1 shadow-[0_0_12px_rgba(52,211,153,0.3)] hover:scale-105 transition-all"
          title="Toggle Web Audio SFX"
        >
          <span id="header-sound-icon">🔊</span>
          <span id="header-sound-label" class="hidden xs:inline font-bold text-[11px]">SFX: ON</span>
        </button>

        <!-- CLI_SANDBOX Fedora Terminal Trigger Button (Purple Glass Aesthetic) -->
        <button 
          id="fedora-cli-trigger-btn"
          type="button" 
          class="glass-pill-button py-1 px-2.5 sm:px-3 text-xs font-mono text-purple-300 hover:text-white border-purple-500/40 bg-purple-500/10 flex items-center gap-1 shadow-[0_0_12px_rgba(139,92,246,0.3)] hover:scale-105 transition-all"
          title="Open Fedora Fastfetch CLI Terminal"
        >
          <span class="text-purple-400 font-bold tracking-tighter">&gt;_</span>
          <span class="hidden xs:inline font-bold text-[11px]">CLI_SANDBOX</span>
        </button>

        <!-- GitHub Handle Pill -->
        <a 
          href="https://github.com/peaush07" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hidden lg:inline-flex glass-pill-button py-1 px-3 text-xs font-mono text-violet-300 hover:text-white items-center gap-1.5 transition-all"
          title="GitHub Profile @peaush07"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>@peaush07</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          aria-label="Toggle Mobile Menu" 
          class="md:hidden glass-pill-button p-2 text-white/80 hover:text-white"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- HEADER BOTTOM WHITE CAT RUNNER PROGRESS BAR -->
    <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-white/5 border-t border-white/10 overflow-visible">
      <!-- Fill Line -->
      <div id="header-line-fill" class="h-full bg-gradient-to-r from-violet-400 via-purple-400 to-fuchsia-400 w-0 transition-all duration-75 shadow-[0_0_10px_rgba(139,92,246,0.8)]"></div>
      
      <!-- WHITE CAT SVG RUNNER -->
      <div id="header-cat-runner" class="absolute -top-5 left-0 -translate-x-1/2 transition-all duration-75 z-20 pointer-events-none">
        <svg class="cat-svg" viewBox="0 0 64 40" width="34" height="22">
          <!-- White Cat Body -->
          <path class="cat-torso" d="M14 18 C14 12, 38 12, 44 18 C48 22, 44 28, 38 28 C28 28, 18 28, 14 24 Z" fill="#FFFFFF" />
          <!-- White Cat Head -->
          <path class="cat-head" d="M42 14 C42 8, 54 8, 54 14 C54 20, 44 22, 42 14 Z" fill="#FFFFFF" />
          <!-- Gold Ears -->
          <polygon points="44,9 48,2 50,9" fill="#FBBF24" stroke="#FFFFFF" stroke-width="1" />
          <polygon points="50,9 54,3 56,10" fill="#FBBF24" stroke="#FFFFFF" stroke-width="1" />
          <!-- Cat Eye -->
          <circle cx="50" cy="12" r="1.5" fill="#030712" />
          <!-- White Cat Tail -->
          <path class="cat-tail" d="M14 19 C8 17, 6 9, 10 5" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" fill="none" />
          <!-- Running Legs -->
          <line class="cat-leg leg-f1" x1="44" y1="26" x2="48" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-f2" x1="40" y1="26" x2="36" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-b1" x1="22" y1="26" x2="26" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
          <line class="cat-leg leg-b2" x1="18" y1="26" x2="14" y2="34" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer Menu (Rich Touch-Optimized Layout) -->
  <div 
    id="mobile-drawer" 
    class="md:hidden fixed top-20 left-3 right-3 z-40 rounded-3xl glass-panel p-5 border border-white/20 shadow-2xl transition-all duration-300 opacity-0 invisible translate-y-[-10px] pointer-events-auto bg-[#0b0e17]/95 backdrop-blur-3xl"
  >
    <div class="flex flex-col gap-2 font-mono">
      <a href="#hero" class="mobile-link px-4 py-3 text-xs font-bold text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span>🏠</span> <span>Home / Hero</span>
      </a>
      <a href="#about" class="mobile-link px-4 py-3 text-xs font-bold text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span>👤</span> <span>About & Experience</span>
      </a>
      <a href="#skills" class="mobile-link px-4 py-3 text-xs font-bold text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span>⚡</span> <span>Skills & Tech Stack</span>
      </a>
      <a href="#projects" class="mobile-link px-4 py-3 text-xs font-bold text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span>📦</span> <span>Featured Projects</span>
      </a>
      <a href="#contact" class="mobile-link px-4 py-3 text-xs font-bold text-white/90 hover:text-white rounded-2xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span>📬</span> <span>Contact & Links</span>
      </a>

      <div class="h-[1px] bg-white/10 my-2"></div>

      <!-- Quick Action Mobile Buttons -->
      <div class="grid grid-cols-2 gap-2 pt-1">
        <button 
          id="mobile-cmd-trigger"
          type="button" 
          class="px-3 py-2.5 rounded-xl bg-violet-500/20 border border-violet-400/40 text-violet-300 font-mono text-[11px] font-bold flex items-center justify-center gap-1.5 active:scale-95 transition-all"
        >
          <span>🔍</span> <span>Search (⌘K)</span>
        </button>
        <button 
          id="mobile-cli-trigger"
          type="button" 
          class="px-3 py-2.5 rounded-xl bg-purple-500/20 border border-purple-400/40 text-purple-300 font-mono text-[11px] font-bold flex items-center justify-center gap-1.5 active:scale-95 transition-all"
        >
          <span>&gt;_</span> <span>Fedora CLI</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* White Cat Running Legs Animations */
  @keyframes catLeg1 {
    0%, 100% { transform: rotate(-20deg); transform-origin: top center; }
    50% { transform: rotate(20deg); transform-origin: top center; }
  }
  @keyframes catLeg2 {
    0%, 100% { transform: rotate(20deg); transform-origin: top center; }
    50% { transform: rotate(-20deg); transform-origin: top center; }
  }
  .leg-f1, .leg-b1 { animation: catLeg1 0.25s infinite ease-in-out; }
  .leg-f2, .leg-b2 { animation: catLeg2 0.25s infinite ease-in-out; }
</style>

<script>
  import { soundFX } from '../scripts/sound-fx.js';

  // White Cat Scroll Tracker Script
  const lineFill = document.getElementById('header-line-fill');
  const catRunner = document.getElementById('header-cat-runner');
  let isScrollTicking = false;

  function updateScrollProgress() {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight <= 0) {
      isScrollTicking = false;
      return;
    }
    const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));

    if (lineFill) lineFill.style.width = `${progress}%`;
    if (catRunner) catRunner.style.left = `${progress}%`;
    isScrollTicking = false;
  }

  function onScrollTick() {
    if (!isScrollTicking) {
      requestAnimationFrame(updateScrollProgress);
      isScrollTicking = true;
    }
  }

  window.addEventListener('scroll', onScrollTick, { passive: true });
  document.addEventListener('DOMContentLoaded', updateScrollProgress);

  // Sound FX Toggle Listener
  const soundBtn = document.getElementById('header-sound-btn');
  const soundIcon = document.getElementById('header-sound-icon');
  const soundLabel = document.getElementById('header-sound-label');

  function updateSoundUI() {
    if (soundFX.isMuted) {
      if (soundIcon) soundIcon.textContent = '🔇';
      if (soundLabel) soundLabel.textContent = 'SFX: OFF';
      soundBtn?.classList.remove('text-emerald-300', 'border-emerald-500/40', 'bg-emerald-500/10');
      soundBtn?.classList.add('text-rose-300', 'border-rose-500/40', 'bg-rose-500/10');
    } else {
      if (soundIcon) soundIcon.textContent = '🔊';
      if (soundLabel) soundLabel.textContent = 'SFX: ON';
      soundBtn?.classList.remove('text-rose-300', 'border-rose-500/40', 'bg-rose-500/10');
      soundBtn?.classList.add('text-emerald-300', 'border-emerald-500/40', 'bg-emerald-500/10');
    }
  }

  if (soundBtn) {
    updateSoundUI();
    soundBtn.addEventListener('click', () => {
      const isMuted = soundFX.toggleMute();
      updateSoundUI();
      if (!isMuted) soundFX.playClick();
    });
  }

  // Cmd+K Spotlight Trigger
  const cmdBtn = document.getElementById('cmd-palette-trigger-btn');
  const mobileCmdBtn = document.getElementById('mobile-cmd-trigger');

  function triggerCmdPalette() {
    soundFX.playClick();
    if ((window as any).openCommandPalette) (window as any).openCommandPalette();
    if (mobileDrawer) {
      mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
      mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
    }
  }

  cmdBtn?.addEventListener('click', triggerCmdPalette);
  mobileCmdBtn?.addEventListener('click', triggerCmdPalette);

  // CLI SANDBOX Fedora Terminal Trigger Script
  const cliTriggerBtn = document.getElementById('fedora-cli-trigger-btn');
  const mobileCliBtn = document.getElementById('mobile-cli-trigger');

  function triggerCliTerminal() {
    soundFX.playClick();
    window.dispatchEvent(new CustomEvent('open-fedora-terminal'));
    if (mobileDrawer) {
      mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
      mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
    }
  }

  cliTriggerBtn?.addEventListener('click', triggerCliTerminal);
  mobileCliBtn?.addEventListener('click', triggerCliTerminal);

  // Mobile Menu Script
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      soundFX.playClick();
      const isVisible = mobileDrawer.classList.contains('opacity-100');
      if (isVisible) {
        mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
      } else {
        mobileDrawer.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileDrawer.classList.add('opacity-100', 'visible', 'translate-y-0');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileDrawer.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
      });
    });
  }
</script>

---

<section id="skills" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Header -->
  <div class="text-center mb-8 sm:mb-10">
    <div class="inline-block px-8 py-3 rounded-full bg-violet-500/20 border border-violet-400/40 backdrop-blur-xl shadow-[0_0_25px_rgba(139,92,246,0.35)] mb-4 float-levitate">
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-wider font-mono">
        SKILLS & TOOLS
      </h2>
    </div>
  </div>

  <!-- Bento Grid Matrix (Authentic High-Definition Brand Logos & Neon Glass Cards) -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

    <!-- Bento 1: FRONT-END WEB (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-violet-400/50 transition-all duration-300">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-violet-300 bg-violet-500/20 px-3.5 py-1 rounded-full border border-violet-400/40 shadow-[0_0_12px_rgba(139,92,246,0.35)]">FRONT-END WEB</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">User Interface & Client Stack</h4>
      
      <!-- 5 Skill Tile Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <svg class="tech-logo w-8 h-8 mb-2 text-white filter drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.665 21.978L8.84 8.788v10.36H6.182V5.008h2.658l9.825 13.19V5.008h2.658v16.97h-2.658z"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">Next.js</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" alt="React" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">React</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg" alt="Tailwind CSS" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Tailwind CSS</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">TypeScript</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300 col-span-2 sm:col-span-1">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JavaScript" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">JavaScript</span>
        </div>
      </div>
    </div>

    <!-- Bento 2: LANGUAGES (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-purple-400/50 transition-all duration-300">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-purple-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-purple-300 bg-purple-500/20 px-3.5 py-1 rounded-full border border-purple-400/40 shadow-[0_0_12px_rgba(168,85,247,0.35)]">LANGUAGES</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Core Programming Languages</h4>
      
      <!-- 6 Skill Tile Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg" alt="Go" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Go (Golang)</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">TypeScript</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Python</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg" alt="C++" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">C++ / C</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dart/dart-original.svg" alt="Dart" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Dart</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JavaScript" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">JavaScript</span>
        </div>
      </div>
    </div>

    <!-- Bento 3: BACK-END TOOLS (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-violet-400/50 transition-all duration-300">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-violet-300 bg-violet-500/20 px-3.5 py-1 rounded-full border border-violet-400/40 shadow-[0_0_12px_rgba(139,92,246,0.35)]">BACK-END TOOLS</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Server Runtimes & APIs</h4>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" alt="Node.js" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Node.js</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg" alt="Go" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Go (Golang)</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Python</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <svg class="tech-logo w-8 h-8 mb-2 text-cyan-400 filter drop-shadow-[0_0_8px_rgba(6,182,212,0.6)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">MCP Servers</span>
        </div>
      </div>
    </div>

    <!-- Bento 4: DEVOPS & CLOUD (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-purple-400/50 transition-all duration-300">
      <div class="absolute top-0 left-8 right-8 h-[1px] bg-gradient-to-r from-transparent via-purple-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-purple-300 bg-purple-500/20 px-3.5 py-1 rounded-full border border-purple-400/40 shadow-[0_0_12px_rgba(168,85,247,0.35)]">DEVOPS & CLOUD</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Deployment & Containers</h4>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <svg class="tech-logo w-8 h-8 mb-2 text-white filter drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">Git & GitHub</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Docker</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-plain.svg" alt="Kubernetes" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Kubernetes</span>
        </div>
        <div class="glass-panel p-4 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all duration-300">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg" alt="Linux CLI" class="tech-logo w-8 h-8 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-xs font-mono font-medium text-white/90">Linux CLI</span>
        </div>
      </div>
    </div>

    <!-- Bento 5: AI TOOLS (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-violet-400/50 transition-all duration-300">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-violet-300 bg-violet-500/20 px-3 py-1 rounded-full border border-violet-400/40 shadow-[0_0_12px_rgba(139,92,246,0.35)]">AI TOOLS</span>
      </div>
      <h4 class="text-lg font-bold text-white mb-4">AI Coding & Assistants</h4>
      
      <div class="grid grid-cols-2 gap-3">
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all">
          <svg class="tech-logo w-7 h-7 mb-1.5 text-violet-400 filter drop-shadow-[0_0_8px_rgba(168,85,247,0.7)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">OpenCode</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all">
          <svg class="tech-logo w-7 h-7 mb-1.5 text-emerald-400 filter drop-shadow-[0_0_8px_rgba(52,211,153,0.7)]" fill="currentColor" viewBox="0 0 24 24"><path d="M22.28 9.82a5.98 5.98 0 0 0-.52-4.91 6.04 6.04 0 0 0-6.51-2.9 6.07 6.07 0 0 0-4.63-2.07 6.07 6.07 0 0 0-5.8 4.22 6.03 6.03 0 0 0-4.14 3 6.03 6.03 0 0 0 .73 6.9 6 6 0 0 0 .52 4.9 6.05 6.05 0 0 0 6.52 2.9A6.05 6.05 0 0 0 13.1 24a6.07 6.07 0 0 0 5.8-4.22 6.03 6.03 0 0 0 4.14-3 6.03 6.03 0 0 0-.76-6.96zM13.1 22.46a4.5 4.5 0 0 1-2.88-1.05l.15-.08 4.79-2.77a.77.77 0 0 0 .39-.67v-6.76l2.03 1.17a.08.08 0 0 1 .04.06v5.58a4.53 4.53 0 0 1-4.52 4.52zM4.6 18.06a4.49 4.49 0 0 1-.54-3.02l.15.09 4.79 2.76a.78.78 0 0 0 .78 0l5.85-3.38v2.35a.08.08 0 0 1-.04.07l-4.83 2.79a4.53 4.53 0 0 1-6.16-1.66zm-1.04-10a4.5 4.5 0 0 1 2.35-1.96v5.67a.78.78 0 0 0 .39.67l5.85 3.38-2.03 1.17a.08.08 0 0 1-.08 0l-4.83-2.79a4.53 4.53 0 0 1-1.65-6.14zm13.3-3.23a4.5 4.5 0 0 1 1.65 6.14l-.15-.09-4.79-2.76a.78.78 0 0 0-.78 0L7.04 11.5V9.15a.08.08 0 0 1 .04-.07l4.83-2.79a4.53 4.53 0 0 1 4.95.54zm2.54 10.3a4.5 4.5 0 0 1-2.35 1.97v-5.68a.78.78 0 0 0-.39-.67l-5.85-3.38 2.03-1.17a.08.08 0 0 1 .08 0l4.83 2.79a4.53 4.53 0 0 1 1.65 6.14z"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">Codex</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all">
          <svg class="tech-logo w-7 h-7 mb-1.5 text-fuchsia-400 filter drop-shadow-[0_0_8px_rgba(217,70,239,0.7)]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">Antigravity</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all">
          <svg class="tech-logo w-7 h-7 mb-1.5 text-cyan-300 filter drop-shadow-[0_0_8px_rgba(6,182,212,0.7)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span class="text-xs font-mono font-medium text-white/90">MCP</span>
        </div>
      </div>
    </div>

    <!-- Bento 6: OTHERS (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-purple-400/50 transition-all duration-300">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-purple-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-purple-300 bg-purple-500/20 px-3 py-1 rounded-full border border-purple-400/40 shadow-[0_0_12px_rgba(168,85,247,0.35)]">OTHERS</span>
      </div>
      <h4 class="text-lg font-bold text-white mb-4">OS & Code Editors</h4>
      
      <div class="grid grid-cols-2 gap-3">
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fedora/fedora-original.svg" alt="Fedora" class="tech-logo w-7 h-7 mb-1.5" />
          <span class="text-xs font-mono font-medium text-white/90">Fedora</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/neovim/neovim-original.svg" alt="NeoVim" class="tech-logo w-7 h-7 mb-1.5" />

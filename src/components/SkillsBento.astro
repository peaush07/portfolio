---
---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Header -->
  <div class="text-center mb-16">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">02 // TECHNICAL CAPABILITIES</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      SKILLS & <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">TOOLS MATRIX</span>
    </h3>
  </div>

  <!-- Bento Grid Matrix -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

    <!-- Bento 1: FRONT-END WEB (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono text-amber-300 bg-amber-500/20 px-3 py-1 rounded-full border border-amber-400/30">FRONT-END WEB</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">User Interface & Client Stack</h4>
      <div class="flex flex-wrap gap-3">
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg" alt="Next.js" class="w-4 h-4 invert" /> Next.js
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" alt="React" class="w-4 h-4" /> React
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg" alt="Tailwind CSS" class="w-4 h-4" /> Tailwind CSS
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" class="w-4 h-4" /> TypeScript
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JavaScript" class="w-4 h-4" /> JavaScript
        </div>
      </div>
    </div>

    <!-- Bento 2: LANGUAGES (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono text-fuchsia-300 bg-fuchsia-500/20 px-3 py-1 rounded-full border border-fuchsia-400/30">LANGUAGES</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Core Programming Languages</h4>
      <div class="flex flex-wrap gap-3">
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-cyan-200 flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg" alt="Go" class="w-4 h-4" /> Go (Golang)
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" class="w-4 h-4" /> TypeScript
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" class="w-4 h-4" /> Python
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg" alt="C++" class="w-4 h-4" /> C++ / C
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dart/dart-original.svg" alt="Dart" class="w-4 h-4" /> Dart
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JavaScript" class="w-4 h-4" /> JavaScript
        </div>
      </div>
    </div>

    <!-- Bento 3: BACK-END TOOLS (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono text-emerald-300 bg-emerald-500/20 px-3 py-1 rounded-full border border-emerald-400/30">BACK-END TOOLS</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Server Runtimes & APIs</h4>
      <div class="flex flex-wrap gap-3">
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" alt="Node.js" class="w-4 h-4" /> Node.js
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg" alt="Go" class="w-4 h-4" /> Go (Golang)
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" class="w-4 h-4" /> Python
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-cyan-200 flex items-center gap-2">
          ⚡ MCP Servers
        </div>
      </div>
    </div>

    <!-- Bento 4: DEVOPS & INFRASTRUCTURE (Span 6) -->
    <div class="md:col-span-6 glass-panel p-6 sm:p-8 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono text-cyan-300 bg-cyan-500/20 px-3 py-1 rounded-full border border-cyan-400/30">DEVOPS & CLOUD</span>
      </div>
      <h4 class="text-xl font-bold text-white mb-6">Deployment & Containers</h4>
      <div class="flex flex-wrap gap-3">
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="Git" class="w-4 h-4 invert" /> Git & GitHub
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" class="w-4 h-4" /> Docker
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-original.svg" alt="Kubernetes" class="w-4 h-4" /> Kubernetes
        </div>
        <div class="glass-pill-button px-4 py-2 text-xs font-mono text-white flex items-center gap-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg" alt="Linux CLI" class="w-4 h-4" /> Linux CLI
        </div>
      </div>
    </div>

    <!-- Bento 5: AI TOOLS (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <span class="text-xs font-mono text-emerald-300 bg-emerald-500/20 px-3 py-1 rounded-full border border-emerald-400/30 inline-block mb-3">AI TOOLS</span>
      <h4 class="text-lg font-bold text-white mb-4">AI Coding & Assistants</h4>
      <div class="flex flex-wrap gap-2">
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">OpenCode</span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">Codex</span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-cyan-200">Antigravity</span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">MCP</span>
      </div>
    </div>

    <!-- Bento 6: OTHERS (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <span class="text-xs font-mono text-amber-300 bg-amber-500/20 px-3 py-1 rounded-full border border-amber-400/30 inline-block mb-3">OTHERS</span>
      <h4 class="text-lg font-bold text-white mb-4">OS & Code Editors</h4>
      <div class="flex flex-wrap gap-2">
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white flex items-center gap-1.5">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fedora/fedora-original.svg" alt="Fedora" class="w-3.5 h-3.5" /> Fedora
        </span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white flex items-center gap-1.5">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/neovim/neovim-original.svg" alt="NeoVim" class="w-3.5 h-3.5" /> NeoVim
        </span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white flex items-center gap-1.5">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" alt="VS Code" class="w-3.5 h-3.5" /> VS Code
        </span>
      </div>
    </div>

    <!-- Bento 7: DOCS & DIAGRAM (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative">
      <span class="text-xs font-mono text-cyan-300 bg-cyan-500/20 px-3 py-1 rounded-full border border-cyan-400/30 inline-block mb-3">DOCS & DIAGRAM</span>
      <h4 class="text-lg font-bold text-white mb-4">Docs & Diagrams</h4>
      <div class="flex flex-wrap gap-2">
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">Markdown</span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">Mermaid</span>
        <span class="glass-pill-button px-3 py-1.5 text-xs font-mono text-white">draw.io</span>
      </div>
    </div>

  </div>
</section>

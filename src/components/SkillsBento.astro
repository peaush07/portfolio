---
---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">

  <!-- Section Header -->
  <div class="text-center mb-16">
    <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-3">02 // Technical Capabilities</h2>
    <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      Skills & <span class="bg-gradient-to-r from-cyan-300 via-indigo-200 to-fuchsia-300 bg-clip-text text-transparent">Bento Matrix</span>
    </h3>
  </div>

  <!-- Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Card 1: Frontend & Glass Design System (Span 2 Cols on MD) -->
    <div class="md:col-span-2 glass-panel p-8 rounded-[2rem] border border-white/20 shadow-2xl relative overflow-hidden group hover:border-white/40 transition-all duration-300">
      <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-cyan-400/80 to-transparent"></div>
      
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-cyan-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 002-2H3a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xl font-bold text-white">Frontend & Glass Systems</h4>
            <p class="text-xs text-white/60 font-mono">VisionOS & iOS 27 Glass Aesthetics</p>
          </div>
        </div>
        <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/30">Mastery</span>
      </div>

      <p class="text-sm text-white/80 mb-8 leading-relaxed">
        Engineered custom backdrop blur tokens, specular highlights, and fluid CSS gradient mesh animations. 
        Expert in Astro, React 19, Tailwind CSS, and WebGL/Canvas micro-animations.
      </p>

      <!-- Skill Bars -->
      <div class="space-y-4">
        <div>
          <div class="flex justify-between text-xs font-mono text-white/80 mb-1.5">
            <span>Astro / React / Modern Frameworks</span>
            <span class="text-cyan-300">98%</span>
          </div>
          <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden p-0.5 border border-white/10">
            <div class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-indigo-400 w-[98%] shadow-[0_0_10px_rgba(34,211,238,0.8)]"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-mono text-white/80 mb-1.5">
            <span>CSS Glassmorphism & Micro-Interactions</span>
            <span class="text-cyan-300">99%</span>
          </div>
          <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden p-0.5 border border-white/10">
            <div class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-fuchsia-400 w-[99%] shadow-[0_0_10px_rgba(34,211,238,0.8)]"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Interactive Motion & Canvas (1 Col) -->
    <div class="glass-panel p-8 rounded-[2rem] border border-white/20 shadow-2xl relative overflow-hidden group hover:border-white/40 transition-all duration-300 flex flex-col justify-between">
      <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-fuchsia-400/80 to-transparent"></div>

      <div>
        <div class="w-10 h-10 rounded-2xl bg-fuchsia-500/20 border border-fuchsia-400/40 flex items-center justify-center text-fuchsia-300 mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>

        <h4 class="text-xl font-bold text-white mb-2">120Hz Motion Engine</h4>
        <p class="text-xs text-white/60 font-mono mb-4">Lenis & Canvas Graphics</p>
        
        <p class="text-sm text-white/80 leading-relaxed mb-6">
          Butter-smooth inertial scrolling, interactive particle grids, 60-120 FPS hardware accelerated animations.
        </p>
      </div>

      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-fuchsia-300">
        <span>Framerate: 120 FPS</span>
        <span class="w-2 h-2 rounded-full bg-fuchsia-400 animate-ping"></span>
      </div>
    </div>

    <!-- Card 3: Backend & Systems Architecture (1 Col) -->
    <div class="glass-panel p-8 rounded-[2rem] border border-white/20 shadow-2xl relative overflow-hidden group hover:border-white/40 transition-all duration-300 flex flex-col justify-between">
      <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-emerald-400/80 to-transparent"></div>

      <div>
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-300 mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
          </svg>
        </div>

        <h4 class="text-xl font-bold text-white mb-2">Backend Systems</h4>
        <p class="text-xs text-white/60 font-mono mb-4">Node.js & REST Architecture</p>
        
        <p class="text-sm text-white/80 leading-relaxed mb-6">
          High throughput REST/GraphQL endpoints, security headers, rate limiting, and cache management.
        </p>
      </div>

      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-emerald-300">
        <span>Latency: &lt;15ms</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
      </div>
    </div>

    <!-- Card 4: Security & DevOps Pipeline (Span 2 Cols on MD) -->
    <div class="md:col-span-2 glass-panel p-8 rounded-[2rem] border border-white/20 shadow-2xl relative overflow-hidden group hover:border-white/40 transition-all duration-300">
      <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-amber-400/80 to-transparent"></div>

      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xl font-bold text-white">DevOps & Security Hardening</h4>
            <p class="text-xs text-white/60 font-mono">Production Guardrails & CI/CD</p>
          </div>
        </div>
        <span class="text-xs font-mono text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/30">Hardened</span>
      </div>

      <p class="text-sm text-white/80 mb-6 leading-relaxed">
        Strict CSP directives, rate-limiting, secret sanitization, isolated docker/GCP deployments, and automated GitHub Actions workflows.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-white/80 text-center">
          HTTPS / TLS 1.3
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-white/80 text-center">
          Strict CSP Headers
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-white/80 text-center">
          GitHub Actions CI
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-white/80 text-center">
          Zero Vulnerabilities
        </div>
      </div>
    </div>

  </div>
</section>

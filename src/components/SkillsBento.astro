      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-purple-300 bg-purple-500/20 px-3 py-1 rounded-full border border-purple-400/40 shadow-[0_0_12px_rgba(168,85,247,0.35)]">OTHERS</span>
      </div>
      <h4 class="text-lg font-bold text-white mb-4">OS & Code Editors</h4>
      
      <div class="grid grid-cols-2 gap-3">
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fedora/fedora-original.svg" alt="Fedora" class="purple-tech-logo w-7 h-7 mb-1.5" />
          <span class="text-xs font-mono font-medium text-white/90">Fedora</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-purple-400/50 hover:bg-purple-500/10 transition-all">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/neovim/neovim-original.svg" alt="NeoVim" class="purple-tech-logo w-7 h-7 mb-1.5" />
          <span class="text-xs font-mono font-medium text-white/90">NeoVim</span>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border border-white/15 shadow-inner flex flex-col items-center justify-center text-center group hover:scale-105 hover:border-violet-400/50 hover:bg-violet-500/10 transition-all col-span-2">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" alt="VS Code" class="purple-tech-logo w-7 h-7 mb-1.5" />
          <span class="text-xs font-mono font-medium text-white/90">VS Code</span>
        </div>
      </div>
    </div>

    <!-- Bento 7: DOCS & DIAGRAM (Span 4) -->
    <div class="md:col-span-4 glass-panel p-6 rounded-[2rem] border border-white/20 shadow-2xl relative hover:border-violet-400/50 transition-all duration-300">
      <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-violet-400/80 to-transparent"></div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold text-violet-300 bg-violet-500/20 px-3 py-1 rounded-full border border-violet-400/40 shadow-[0_0_12px_rgba(139,92,246,0.35)]">DOCS & DIAGRAM</span>
      </div>
      <h4 class="text-lg font-bold text-white mb-4">Docs & Visual Diagrams</h4>
      

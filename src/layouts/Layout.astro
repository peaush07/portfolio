---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Peaush Paul | Full Stack & Systems Developer Portfolio",
  description = "Peaush Paul (peaush07) - Full Stack & Systems Developer portfolio showcasing open-source projects, cloud native tools, AI dashboards, and software engineering."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-style="liquid-glass" data-theme="nebula" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="https://github.com/peaush07.png?size=64" />
    <link rel="apple-touch-icon" href="https://github.com/peaush07.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Peaush Paul, peaush07, Developer, Open Source, Portfolio, JavaScript, React, Python, Go, C++, Web Developer, Full Stack" />
    <meta name="theme-color" content="#030712" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Peaush Paul | Developer Portfolio" />
    <meta property="og:description" content="Showcasing projects, skills, and open-source contributions by Peaush Paul (@peaush07)." />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/231284231?v=4" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#030712] text-slate-100 font-sans antialiased overflow-x-hidden relative min-h-screen">
    
    <!-- Ambient Fluid Mesh Background -->
    <div class="fluid-bg-container">
      <div class="fluid-orb fluid-orb-1"></div>
      <div class="fluid-orb fluid-orb-2"></div>
      <div class="fluid-orb fluid-orb-3"></div>
    </div>

    <!-- Interactive Canvas Grid -->
    <canvas id="squares-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-40"></canvas>

    <!-- Main App Content -->
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Lenis, Cat Cursor & Canvas Initialization Scripts -->
    <script>
      import Lenis from 'lenis';
      import { initAmbientSquaresCanvas } from '../scripts/squares-canvas.js';
      import { initCatCursor } from '../scripts/cat-cursor.js';

      const lenis = new Lenis({
        duration: 0.85,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.15,
        touchMultiplier: 1.5,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      initAmbientSquaresCanvas('squares-canvas');
      initCatCursor();
    </script>

  </body>
</html>
